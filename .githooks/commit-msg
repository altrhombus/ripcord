#!/bin/sh
# The leak guard (tools/leak-guard/check.py) on the commit message. Turned on with: git config core.hooksPath .githooks
# Without the dirty room there is nothing to check against, so a clone pays nothing.
root=$(git rev-parse --show-toplevel) || exit 0
[ -d "$root/docs/protocol/captures" ] || exit 0
exec python3 "$root/tools/leak-guard/check.py" --message "$1"
