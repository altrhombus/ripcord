<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Cross-platform (no Windows/WinRT deps) so the Opus decode + resample can be unit-tested off-device.
    Ripcord.Media (Windows-only) references this for the audio path; the WASAPI render stays native.
  -->
  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ripcord.Core\Ripcord.Core.csproj" />
  </ItemGroup>

</Project>
