<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Ripcord_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Ripcord_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  A settings row: label + description on the left, control on the right.  -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <!--
            BasedOn, not a Setter for Style: setting the Style property from inside a Style is invalid XAML and
            throws when the page is parsed — which took the whole app down on navigation rather than failing
            visibly on this page.
        -->
        <Style
            x:Key="GroupHeaderStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel MaxWidth="820" Spacing="6">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <!--  ============ Video ============  -->
            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Video" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Resolution and frame rate" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="720p60 is the verified-good default. Higher settings need a strong network."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="ResolutionCombo"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Resolution and frame rate" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Maximum bitrate" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="The starting rate. Ripcord lowers it automatically if the network can't keep up."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            x:Name="BitrateValueText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <Slider
                        x:Name="BitrateSlider"
                        AutomationProperties.Name="Maximum bitrate in megabits per second"
                        Maximum="40"
                        Minimum="2"
                        StepFrequency="1" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Adapt quality automatically" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Lower the bitrate on packet loss, and on battery or when the device gets hot."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="AdaptiveToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Adapt quality automatically" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Image scaling" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="How the stream is scaled up to fill the window."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="UpscaleCombo"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Image scaling" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tell the console about your connection (experimental)" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Sends the measured delay and packet loss to the console, and asks it for the bitrate Ripcord thinks your connection can carry. Off by default because it is not yet verified against real hardware — turn it on and watch the diagnostics graph to see whether it helps."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="ConnectionQualityToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Tell the console about your connection" />
                </Grid>
            </Border>

            <!--  ============ Graphics device ============  -->
            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Graphics device" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Which GPU to use" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Automatic picks the GPU driving your display, which is usually both the fastest and the most efficient choice for streaming. Takes effect on the next connection."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Name="GpuCombo"
                            Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Which GPU to use" />
                    </Grid>
                    <!--  Video codec. HEVC is offered only when a decoder for it actually exists on this
                          machine (HEVC support depends on the GPU and on the HEVC Video Extension), so the
                          option cannot be selected into a session that then fails to start.  -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Video codec" />
                            <TextBlock
                                x:Name="CodecHelpText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Name="CodecCombo"
                            Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Video codec" />
                    </Grid>
                    <!--
                        Keyboard input. Off by default: with a pad connected there is no reason for stray typing
                        to reach the game, and the default layout overlaps ordinary window shortcuts.
                    -->
                    <ToggleSwitch
                        x:Name="KeyboardToggle"
                        Header="Send keyboard input to the console" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="KeyBindingsButton"
                            Click="KeyBindings_Click"
                            Content="Configure keys and gamepad mapping…" />
                        <TextBlock
                            x:Name="KeyboardSummaryText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>

                    <!--  HDR. Enabled only with HEVC selected, because HDR needs a 10-bit stream and the AVC the
                          console offers is 8-bit — the two settings together would be incoherent.

                          No longer "(experimental)": the console's response was verified on hardware
                          (2026-08-02) and true HDR output is implemented, so the label would now be warning
                          about a risk that no longer exists. What the request depends on is external setup,
                          which is what the help text below covers.  -->
                    <ToggleSwitch
                        x:Name="HdrToggle"
                        Header="Request HDR" />
                    <!--
                        Readiness checklist rather than a paragraph of prose. HDR needs four things and only
                        one of them is this toggle, so a user whose picture stays SDR has no way to tell WHICH
                        prerequisite is missing from a sentence that lists them all. Each row reports its own
                        state and, when unmet, says what to do about it.

                        The console row is deliberately neutral rather than a tick or a cross: whether the PS5
                        sends HDR cannot be known until a session is running, and showing a cross for
                        "unknown" would read as a fault the user should go and fix.
                    -->
                    <StackPanel x:Name="HdrChecklist" Margin="0,2,0,0" Spacing="3" />
                    <TextBlock
                        x:Name="HdrHelpText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="AdapterCombo"
                        MinWidth="280"
                        AutomationProperties.Name="Specific graphics adapter"
                        Visibility="Collapsed" />
                    <InfoBar
                        x:Name="AdapterWarning"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning" />
                </StackPanel>
            </Border>

            <!--  ============ Controls ============  -->
            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Controls" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Leave a stream with the controller" />
                        <TextBlock
                            x:Name="ExitGestureDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="ExitGestureCombo"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Leave a stream with the controller" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Menu stick sensitivity" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="How far you must push the stick to move between items in Ripcord's own menus."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            x:Name="DeadzoneValueText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <Slider
                        x:Name="DeadzoneSlider"
                        AutomationProperties.Name="Menu stick sensitivity"
                        Maximum="0.9"
                        Minimum="0.1"
                        StepFrequency="0.05" />
                </StackPanel>
            </Border>

            <!--  ============ Display ============  -->
            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Display" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Full screen when a stream starts" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Hides the title bar and navigation while you play."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="FullScreenToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Full screen when a stream starts" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ask before disconnecting" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Confirms when you end a stream, and lets you choose rest mode for that disconnect. Off leaves instantly, using the default below."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="ConfirmOnDisconnectToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Ask before disconnecting" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Rest console when I disconnect" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="The default answer for rest mode: puts the console into rest when you end the stream, instead of leaving it awake."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="RestOnDisconnectToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Rest console when I disconnect" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Show connection diagnostics" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Frame rate, latency and packet loss over the video. You can also toggle this with F3 while streaming."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="DiagnosticsToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Show connection diagnostics" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Larger text and controls" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Easier to read on a handheld or from across the room."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="LargeUiToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Larger text and controls" />
                </Grid>
            </Border>

            <!--  ============ Security ============  -->
            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Saved consoles" />

            <InfoBar
                x:Name="CredentialProtectionBar"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
