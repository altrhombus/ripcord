<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Ripcord_App.Pages.ConsolesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ripcord_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Ripcord_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Ripcord_App.Services"
    xmlns:vm="using:Ripcord.Presentation.Consoles"
    SizeChanged="OnPageSizeChanged"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            The card. Two layers: a Border for the surface, and a Rectangle inside it carrying a wash of the
            console's vendor accent. Same trick the About page's identity card uses — kept to a low opacity so
            it reads as a tint over Mica rather than a coloured panel, and rounded on the rectangle itself
            rather than relying on the parent to clip.

            The whole card is the primary action. That is one focus stop per console for a controller, which
            is the entire reason it is built this way rather than as a row of buttons: a pad should reach a
            console in one press, not tab past a Connect and a Remove to get to the next one. Secondary
            actions live in the overflow flyout, which is also wired as the card's ContextFlyout so
            right-click and the pad's menu button both open it.
        -->
        <!--
            Bindings go through State, which is the view-model's single notifying property: the whole card is one
            immutable record, recomposed on any change. So every binding here is Mode=OneWay on a State.* path,
            and the leaf values need no notification of their own.
        -->
        <DataTemplate x:Key="ConsoleCardTemplate" x:DataType="vm:ConsoleCardViewModel">
            <Border
                Background="{ThemeResource RipcordCardFillBrush}"
                BorderBrush="{ThemeResource RipcordCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RipcordCardCornerRadius}"
                AutomationProperties.Name="{x:Bind State.AutomationName, Mode=OneWay}"
                ContextRequested="OnCardContextRequested"
                PointerCanceled="OnCardUnhighlight"
                PointerCaptureLost="OnCardUp"
                PointerEntered="OnCardHighlight"
                PointerExited="OnCardUnhighlight"
                PointerPressed="OnCardDown"
                PointerReleased="OnCardUp">

                <!--
                    Clipped to the card's own radius so the wedge can run to three of its edges without a
                    square corner poking out. Everything stacks inside this one Grid: highlight, hover wash,
                    wedge, content, overflow.
                -->
                <!--
                    RenderTransformOrigin is the centre so a press settles inwards rather than pulling toward
                    a corner. The scale itself is driven from code, gated on AppMotion.Enabled - the card is
                    on the path to play, and the standing rule there is that nothing may stand between the
                    player and the press.
                -->
                <Grid
                    CornerRadius="{StaticResource RipcordCardCornerRadius}"
                    RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="PressScale" />
                    </Grid.RenderTransform>

                    <!--  The inner top highlight. One hairline of light; see Ripcord.Card.xaml.  -->
                    <Rectangle Fill="{ThemeResource RipcordCardHighlightBrush}" />

                    <!--
                        Hover only. Focus is a ring drawn OUTSIDE the card by the system focus visual, which
                        is a different kind of mark on purpose: the two used to be one wash at two opacities,
                        0.10 and 0.22, and were indistinguishable on a real screen.
                    -->
                    <Rectangle
                        Fill="{ThemeResource RipcordCardHoverOverlayBrush}"
                        Visibility="{x:Bind State.IsHighlighted, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!--
                        The wedge, trailing edge, full height. 92 of the card's 280 - a third of it, which is
                        what stops it reading as an icon that wandered right. Muted rather than removed when
                        the console did not answer; PlayWedge.xaml has the argument for that departure.
                    -->
                    <controls:PlayWedge
                        Width="{x:Bind State.Density, Mode=OneWay, Converter={StaticResource Density}, ConverterParameter=Wedge}"
                        HorizontalAlignment="Right"
                        Accent="{x:Bind State.Accent, Mode=OneWay, Converter={StaticResource AccentBrush}}"
                        AccentColor="{x:Bind State.Accent, Mode=OneWay, Converter={StaticResource AccentColor}}"
                        FacetFill="{ThemeResource RipcordWedgeFacetBrush}"
                        MarkFill="{ThemeResource TextFillColorPrimaryBrush}"
                        IsDown="{x:Bind State.IsPressed, Mode=OneWay}"
                        IsHot="{x:Bind State.IsPointerOver, Mode=OneWay}"
                        Muted="{x:Bind State.IsReachable, Mode=OneWay, Converter={StaticResource Not}}"
                        MutedAccent="{ThemeResource ControlStrongFillColorDisabledBrush}" />

                    <!--
                        Content sits in the leading two-thirds. The right margin clears the wedge, and the
                        rows are Auto with one * spacer so a short card closes up whitespace rather than
                        clipping its last line - the failure that ate a third of "Played 31 min ago" when the
                        slack lived on a row that held text.
                    -->
                    <Grid Margin="{x:Bind State.Density, Mode=OneWay, Converter={StaticResource Density}, ConverterParameter=Margin}">
                        <!--
                            Five rows, and last-played gets its own. It shared the status row for one build
                            and "Played 11 Sep 2026" came out as "Played 11 Sep 2" - the text column here is
                            about 164px once the wedge and the padding are taken out, which is not enough for
                            a status word and a date side by side. The hero has room for both; this does not.
                        -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            The name leads. Two lines at most, and the right margin holds the overflow button
                            off its first line. The tooltip REPEATS the name rather than being the only copy:
                            touch never hovers, so anything reachable by hover alone is unreachable on a
                            handheld. Details in the overflow menu is the copy reachable by finger, pad and
                            mouse.
                        -->
                        <TextBlock
                            Margin="0,0,36,0"
                            MaxLines="2"
                            Style="{x:Bind State.Density, Mode=OneWay, Converter={StaticResource Density}, ConverterParameter=NameStyle}"
                            Text="{x:Bind State.DisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{x:Bind State.DisplayName, Mode=OneWay}" />

                        <!--  The vendor trail sits with the family it names, not off on its own.  -->
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,6,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <controls:FamilyMark
                                Width="9"
                                Height="16"
                                VerticalAlignment="Center"
                                Accent="{x:Bind State.Accent, Mode=OneWay, Converter={StaticResource AccentBrush}}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind State.Details, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!--
                            Status, last. A coloured dot AND the word, never colour alone. While the probe is
                            in flight the dot is a spinner instead: "finding out" and "found out, it is
                            nothing" are opposite answers and must not look alike.
                        -->
                        <!--
                            Below hero density this row exists and the status row is beneath it; at hero
                            density it collapses and the caption moves onto the status line instead. Two
                            TextBlocks rather than one moved between rows, because a Grid.Row is not bindable
                            and a template that re-parents a child on a state change is a worse thing to own
                            than a duplicated four-line binding.
                        -->
                        <TextBlock
                            Grid.Row="3"
                            Margin="0,0,0,4"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind State.LastConnectedLabel, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind State.Density, Mode=OneWay, Converter={StaticResource Density}, ConverterParameter=Stacked}" />

                        <StackPanel
                            Grid.Row="4"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Grid
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{x:Bind State.StatusTone, Mode=OneWay, Converter={StaticResource StatusBrush}}"
                                    Visibility="{x:Bind State.IsChecking, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ProgressRing
                                    Width="10"
                                    Height="10"
                                    IsActive="True"
                                    Visibility="{x:Bind State.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind State.StatusLabel, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />

                            <!--  The hero's copy of the caption: same fact, one line up.  -->
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind State.LastConnectedLabel, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind State.Density, Mode=OneWay, Converter={StaticResource Density}, ConverterParameter=OneLine}" />
                        </StackPanel>
                    </Grid>

                    <!--
                        The action names itself over the wedge, at hero density only. "Wake & play" versus
                        "Play" is the difference between expecting a stream and expecting a wait, and the
                        hero is the one card with room to say which. On a dense card the status line already
                        carries the state and the wedge already says the card launches.
                    -->
                    <TextBlock
                        Margin="0,0,20,18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind State.PrimaryActionLabel, Mode=OneWay}"
                        Visibility="{x:Bind State.Density, Mode=OneWay, Converter={StaticResource Density}, ConverterParameter=ActionLabel}" />

                    <!--
                        The overflow floats over the content rather than sitting in it, so a 48px hit area
                        does not push the title down. A button nested inside a clickable item is fine: it
                        handles the pointer first, so opening the menu does not also start a connect.
                    -->
                    <Button
                        MinWidth="{StaticResource RipcordTouchTarget}"
                        MinHeight="{StaticResource RipcordTouchTarget}"
                        Margin="{x:Bind State.Density, Mode=OneWay, Converter={StaticResource Density}, ConverterParameter=Overflow}"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        x:Uid="ConsolesPage_MoreOptionsConsole"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnConsoleOverflowClick"
                        Tag="{x:Bind}">
                        <FontIcon FontSize="{ThemeResource RipcordIconSizeBody}" Glyph="&#xE712;" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            The add tile, drawn as a ghost of a console card so it reads as "one more of these" rather than as
            a button that wandered into the grid.
        -->
        <DataTemplate x:Key="AddConsoleCardTemplate" x:DataType="services:AddConsolePlaceholder">
            <Grid x:Uid="ConsolesPage_AddConsole2">
                <!--
                    A dashed outline, which a Border cannot draw — StrokeDashArray belongs to Shape. So the
                    outline is a Rectangle sitting over the fill, sized to the tile.
                -->
                <!--
                    The card's own material, at lower emphasis. It was a flat SubtleFillColorSecondaryBrush,
                    which looked fine beside the old flat cards and looked like a different app beside the
                    new ones - a grey rectangle sitting in a row of gradients. A ghost of a card has to be
                    made of the same stuff as the card, or it stops reading as "one more of these".

                    Opacity rather than a second set of colours: one number says "this one is not real yet",
                    and it cannot drift out of step with the card the way a parallel palette would.
                -->
                <Rectangle
                    Fill="{ThemeResource RipcordCardFillBrush}"
                    Opacity="0.5"
                    RadiusX="8"
                    RadiusY="8"
                    Stroke="{ThemeResource RipcordCardStrokeBrush}"
                    StrokeDashArray="4,3"
                    StrokeThickness="1" />
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <FontIcon
                        FontSize="{ThemeResource RipcordIconSizeHero}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE710;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        x:Uid="ConsolesPage_AddConsole" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <services:ConsoleCardTemplateSelector
            x:Key="CardTemplateSelector"
            AddTemplate="{StaticResource AddConsoleCardTemplate}"
            ConsoleTemplate="{StaticResource ConsoleCardTemplate}" />

        <!--
            Strip the container's own chrome so the card is the whole visual, and stretch the content so every
            card in a row is the same height whatever its text does. The corner radius has to match the card's
            or the focus rectangle cuts its corners.
        -->
        <Style x:Key="ConsoleCardContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RipcordCardCornerRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />

            <!--
                The focus ring, on the CONTAINER, because the container is what a GridView actually focuses -
                the template's Border never receives focus from a pad at all.

                Heavier than stock (3/2 against WinUI's 2/1) because this app's standing invariant is that
                focus is legible at 2 m, and the default weight was drawn for a mouse at desk distance. It is
                still the SYSTEM focus visual rather than a border drawn in the template, which is what makes
                it correct in high contrast without anyone remembering to think about it.

                The negative margin lifts the ring clear of the card's own stroke. Adjacent, the two read as
                one thick edge, which is how a focus ring goes unnoticed on a surface that already has a
                border.
            -->
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource RipcordFocusPrimaryThickness}" />
            <Setter Property="FocusVisualSecondaryThickness" Value="{StaticResource RipcordFocusSecondaryThickness}" />
            <Setter Property="FocusVisualMargin" Value="{StaticResource RipcordFocusMargin}" />
        </Style>
    </Page.Resources>

    <!--
        Capped and centred rather than stretched. On an ultrawide an uncapped card row spreads a handful of
        consoles across a metre of glass with the eye travelling between them; 1400 is about where a row stops
        reading as a group. Below that it simply fills, so nothing changes on a handheld.
    -->
    <Grid
        Padding="24,16,24,0"
        MaxWidth="1400"
        HorizontalAlignment="Center"
        RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

            <!--  The one-console "add another" link, which is not part of the scrolling grid.  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            No add button up here. There used to be one beside the title, kept on the reasoning that a header
            button is what people look for and stays reachable when the grid scrolls — but it sat about two
            hundred pixels from the ghost tile that does the same thing, and it wore AccentButtonStyle, which
            made "Add console" the loudest element on a page whose entire point is Play. Two affordances for one
            action, and the wrong one shouting.

            The grid does not scroll at the console counts that actually occur, so the tile is always in view.
            If a filter header ever arrives for large collections, a persistent add command belongs there.
        -->
        <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource TitleTextBlockStyle}"
            x:Uid="ConsolesPage_Consoles" />

        <TextBlock
            x:Name="SubtitleText"
            Grid.Row="1"
            Margin="0,0,0,12"
            Style="{StaticResource RipcordSubtleCaptionStyle}"
            x:Uid="ConsolesPage_PickOneStartStreaming" />

        <!--
            The one-console layout is no longer a layout. It was its own StackPanel with its own card and
            its own RenderHero(), and the two copies drifted three ways in a single release: the hero could
            not show the "checking" spinner, its overflow button sat under the touch minimum, and changes
            made to the grid card were routinely not made to it.

            Every fact RenderHero() set by hand was already on ConsoleCardState. The hero needed code-behind
            only because it was not inside an items control - so it is inside one now. The GridView always
            renders, CardMetrics returns a hero-sized cell when there is one console, and the card template
            reads its own density. Divergence stops being discouraged and becomes unrepresentable, which is
            the only version of that rule that holds.

            What survives is the link: "Add another console" stays a quiet HyperlinkButton rather than a
            ghost tile, because at one console a second hero-sized tile would make adding one look like half
            the page.
        -->
        <HyperlinkButton
            x:Name="HeroAddLink"
            Grid.Row="3"
            Margin="0,4,0,24"
            HorizontalAlignment="Center"
            Click="OnAddConsoleClick"
            Visibility="Collapsed"
            x:Uid="ConsolesPage_AddAnotherConsole" />

        <!--  Empty state — shown when no consoles are paired.  -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            Margin="0,0,0,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="520"
            Spacing="18">
            <!--
                The FULL mark, not FamilyMark. This surface is about Ripcord rather than about a console, and
                FamilyMark is the console badge - its own XAML says the wedge is left out because the wedge is
                the app's identity. No wordmark either: the title bar already carries the name.
            -->
            <controls:RipcordMark
                Width="88"
                Height="88"
                WedgeFill="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                x:Uid="ConsolesPage_FirstRunTitle"
                TextAlignment="Center" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                x:Uid="ConsolesPage_AddConsoleOnceStays"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="EmptyStateAddButton"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                Click="OnAddConsoleClick"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="{ThemeResource RipcordIconSizeAction}" Glyph="&#xE710;" />
                    <TextBlock x:Uid="ConsolesPage_AddConsoleButton" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--
            GridView rather than ItemsRepeater on purpose: it is the items control with real directional-focus
            and gamepad behaviour built in, which is the whole point of the card-per-console layout here.
        -->
        <GridView
            x:Name="ConsoleGrid"
            Grid.Row="2"
            Padding="0,0,0,24"
            ContainerContentChanging="OnPrepareConsoleContainer"
            IsItemClickEnabled="True"
            ItemContainerStyle="{StaticResource ConsoleCardContainerStyle}"
            ItemClick="OnConsoleCardClick"
            ItemTemplateSelector="{StaticResource CardTemplateSelector}"
            SelectionMode="None"
            Visibility="Collapsed">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--
                        These are CELL sizes, and the cell has to contain the container's gutter margin as well
                        as the card. ConsoleCardContainerStyle sets Margin="0,0,12,12" — ItemsWrapGrid has no
                        spacing of its own — so the visible card is 12 smaller than each number here: 280x176
                        inside a 292x188 cell.

                        Getting this wrong is not obvious, which is why it was wrong: at ItemHeight 176 the card
                        was 164 tall while the template's rows were sized for 176, so the "Played 31 min ago"
                        line lost its bottom third. It clipped rather than reflowing because that row is the
                        only Height="*" one, so it absorbed the whole 12px shortfall on its own.
                    -->
                    <ItemsWrapGrid
                        ItemHeight="188"
                        ItemWidth="292"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
    </Grid>
</Page>
