<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Ripcord_App.Pages.ConsolesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ripcord_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Ripcord_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Ripcord_App.Services"
    xmlns:vm="using:Ripcord.Presentation.Consoles"
    SizeChanged="OnPageSizeChanged"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            The card. Two layers: a Border for the surface, and a Rectangle inside it carrying a wash of the
            console's vendor accent. Same trick the About page's identity card uses — kept to a low opacity so
            it reads as a tint over Mica rather than a coloured panel, and rounded on the rectangle itself
            rather than relying on the parent to clip.

            The whole card is the primary action. That is one focus stop per console for a controller, which
            is the entire reason it is built this way rather than as a row of buttons: a pad should reach a
            console in one press, not tab past a Connect and a Remove to get to the next one. Secondary
            actions live in the overflow flyout, which is also wired as the card's ContextFlyout so
            right-click and the pad's menu button both open it.
        -->
        <!--
            Bindings go through State, which is the view-model's single notifying property: the whole card is one
            immutable record, recomposed on any change. So every binding here is Mode=OneWay on a State.* path,
            and the leaf values need no notification of their own.
        -->
        <DataTemplate x:Key="ConsoleCardTemplate" x:DataType="vm:ConsoleCardViewModel">
            <Border
                Padding="0"
                AutomationProperties.Name="{x:Bind State.AutomationName, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ContextRequested="OnCardContextRequested"
                CornerRadius="{StaticResource RipcordCardCornerRadius}"
                GotFocus="OnCardHighlight"
                LostFocus="OnCardUnhighlight"
                PointerCanceled="OnCardUnhighlight"
                PointerEntered="OnCardHighlight"
                PointerExited="OnCardUnhighlight">
                <Grid>
                    <Rectangle
                        Opacity="{x:Bind State.IsHighlighted, Mode=OneWay, Converter={StaticResource WashOpacity}}"
                        RadiusX="8"
                        RadiusY="8">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="{x:Bind State.Accent, Mode=OneWay, Converter={StaticResource AccentColor}}" />
                                <GradientStop Offset="0.9" Color="Transparent" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid Padding="16,14,12,14" RowSpacing="2">
                        <!--
                            The slack lives in an EMPTY row (4), not in a row that holds text. When it was on the
                            last-connected line instead, any shortfall was absorbed by clipping that line rather
                            than by closing up whitespace — which is how a 12px cell-size error turned into a
                            visibly chopped "Played 31 min ago". Content rows are Auto so they always get the
                            height they ask for; row 4 gives back whatever is left.
                        -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  The vendor mark: the trail from the app mark, in this vendor's colour.  -->
                        <controls:FamilyMark
                            Width="13"
                            Height="23"
                            HorizontalAlignment="Left"
                            Accent="{x:Bind State.Accent, Mode=OneWay, Converter={StaticResource AccentBrush}}" />

                        <!--
                            The overflow. A button nested inside a clickable item is fine — it handles the
                            pointer first, so opening the menu does not also start a connect.
                        -->
                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="More options for this console"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnConsoleOverflowClick"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="More options">
                            <FontIcon FontSize="{ThemeResource RipcordIconSizeBody}" Glyph="&#xE712;" />
                        </Button>

                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,10,0,0"
                            MaxLines="2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind State.DisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{x:Bind State.DisplayName, Mode=OneWay}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind State.Details, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Margin="0,2,0,0"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind State.LastConnectedLabel, Mode=OneWay}"
                            Visibility="{x:Bind State.HasLastConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <!--
                            Status and the primary action share the last row: the state, then what activating
                            the card will do about it.
                        -->
                        <Grid
                            Grid.Row="5"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,0"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                A coloured dot AND the word, never colour alone. While the probe is still in
                                flight the dot is a spinner instead — "finding out" and "found out, it's
                                nothing" are opposite answers and must not look alike.
                            -->
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Grid Width="10" Height="10">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{x:Bind State.StatusTone, Mode=OneWay, Converter={StaticResource StatusBrush}}"
                                        Visibility="{x:Bind State.IsChecking, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <ProgressRing
                                        Width="10"
                                        Height="10"
                                        IsActive="True"
                                        Visibility="{x:Bind State.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind State.StatusLabel, Mode=OneWay}" />
                            </StackPanel>

                            <!--
                                Not a Button: the card itself is the button. This is the affordance that says
                                so, and dims when the console did not answer at all.
                            -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Opacity="{x:Bind State.CanConnect, Mode=OneWay, Converter={StaticResource ActionOpacity}}"
                                Orientation="Horizontal"
                                Spacing="6">
                                <FontIcon
                                    FontSize="{ThemeResource RipcordIconSizeCaption}"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE768;"
                                    Visibility="{x:Bind State.ActionGlyph, Mode=OneWay, Converter={StaticResource ActionGlyphIs}, ConverterParameter=Play}" />
                                <FontIcon
                                    FontSize="{ThemeResource RipcordIconSizeCaption}"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE7E8;"
                                    Visibility="{x:Bind State.ActionGlyph, Mode=OneWay, Converter={StaticResource ActionGlyphIs}, ConverterParameter=Wake}" />
                                <TextBlock
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind State.PrimaryActionLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            The add tile, drawn as a ghost of a console card so it reads as "one more of these" rather than as
            a button that wandered into the grid.
        -->
        <DataTemplate x:Key="AddConsoleCardTemplate" x:DataType="services:AddConsolePlaceholder">
            <Grid AutomationProperties.Name="Add a console">
                <!--
                    A dashed outline, which a Border cannot draw — StrokeDashArray belongs to Shape. So the
                    outline is a Rectangle sitting over the fill, sized to the tile.
                -->
                <Rectangle
                    Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                    RadiusX="8"
                    RadiusY="8"
                    Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                    StrokeDashArray="4,3"
                    StrokeThickness="1" />
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <FontIcon
                        FontSize="{ThemeResource RipcordIconSizeHero}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE710;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Add a console" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <services:ConsoleCardTemplateSelector
            x:Key="CardTemplateSelector"
            AddTemplate="{StaticResource AddConsoleCardTemplate}"
            ConsoleTemplate="{StaticResource ConsoleCardTemplate}" />

        <!--
            Strip the container's own chrome so the card is the whole visual, and stretch the content so every
            card in a row is the same height whatever its text does. The corner radius has to match the card's
            or the focus rectangle cuts its corners.
        -->
        <Style x:Key="ConsoleCardContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RipcordCardCornerRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Page.Resources>

    <!--
        Capped and centred rather than stretched. On an ultrawide an uncapped card row spreads a handful of
        consoles across a metre of glass with the eye travelling between them; 1400 is about where a row stops
        reading as a group. Below that it simply fills, so nothing changes on a handheld.
    -->
    <Grid
        Padding="24,16,24,0"
        MaxWidth="1400"
        HorizontalAlignment="Center"
        RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            No add button up here. There used to be one beside the title, kept on the reasoning that a header
            button is what people look for and stays reachable when the grid scrolls — but it sat about two
            hundred pixels from the ghost tile that does the same thing, and it wore AccentButtonStyle, which
            made "Add console" the loudest element on a page whose entire point is Play. Two affordances for one
            action, and the wrong one shouting.

            The grid does not scroll at the console counts that actually occur, so the tile is always in view.
            If a filter header ever arrives for large collections, a persistent add command belongs there.
        -->
        <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Consoles" />

        <TextBlock
            x:Name="SubtitleText"
            Grid.Row="1"
            Margin="0,0,0,12"
            Style="{StaticResource RipcordSubtleCaptionStyle}"
            Text="Pick one to start streaming. A console in rest mode will be woken for you." />

        <!--
            The one-console layout, and the reason it exists: one or two consoles is the real case, and a grid
            of one is a list pretending to be a choice. Here the console IS the page, and the thing you came to
            do is a full-width accent button that holds focus on load. Open the window, press A, playing.

            "Add another console" is a quiet link rather than a second button, because on this layout there is
            exactly one thing worth pressing and it is not that.
        -->
        <StackPanel
            x:Name="HeroPanel"
            Grid.Row="2"
            Margin="0,8,0,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="520"
            Spacing="16"
            Visibility="Collapsed">
            <Border
                x:Name="HeroCard"
                Padding="28,24"
                ContextRequested="OnHeroContextRequested"
                Style="{StaticResource RipcordCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:FamilyMark
                        x:Name="HeroMark"
                        Width="26"
                        Height="46"
                        VerticalAlignment="Top" />

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            x:Name="HeroName"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="HeroDetails"
                            Style="{StaticResource RipcordSubtleCaptionStyle}" />
                        <TextBlock
                            x:Name="HeroLastPlayed"
                            Style="{StaticResource RipcordSubtleCaptionStyle}" />
                        <StackPanel
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Ellipse
                                x:Name="HeroStatusDot"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center" />
                            <TextBlock x:Name="HeroStatus" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Button
                        x:Name="HeroOverflowButton"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="More options for this console"
                        Click="OnHeroOverflowClick"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="{ThemeResource RipcordIconSizeCaption}" Glyph="&#xE712;" />
                    </Button>
                </Grid>
            </Border>

            <Button
                x:Name="HeroPlayButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="OnHeroPlayClick"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="HeroPlayIcon" FontSize="{ThemeResource RipcordIconSizeAction}" />
                    <TextBlock x:Name="HeroPlayLabel" />
                </StackPanel>
            </Button>

            <HyperlinkButton
                x:Name="HeroAddLink"
                HorizontalAlignment="Center"
                Click="OnAddConsoleClick"
                Content="Add another console" />
        </StackPanel>

        <!--  Empty state — shown when no consoles are paired.  -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            Margin="0,0,0,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="380"
            Spacing="14">
            <controls:FamilyMark
                Width="26"
                Height="46"
                Accent="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="No consoles yet"
                TextAlignment="Center" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Add your console once and it stays paired. Ripcord finds it on your network, so you won't need its address."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="EmptyStateAddButton"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                Click="OnAddConsoleClick"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="{ThemeResource RipcordIconSizeAction}" Glyph="&#xE710;" />
                    <TextBlock Text="Add a console" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--
            GridView rather than ItemsRepeater on purpose: it is the items control with real directional-focus
            and gamepad behaviour built in, which is the whole point of the card-per-console layout here.
        -->
        <GridView
            x:Name="ConsoleGrid"
            Grid.Row="2"
            Padding="0,0,0,24"
            ContainerContentChanging="OnPrepareConsoleContainer"
            IsItemClickEnabled="True"
            ItemContainerStyle="{StaticResource ConsoleCardContainerStyle}"
            ItemClick="OnConsoleCardClick"
            ItemTemplateSelector="{StaticResource CardTemplateSelector}"
            SelectionMode="None"
            Visibility="Collapsed">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--
                        These are CELL sizes, and the cell has to contain the container's gutter margin as well
                        as the card. ConsoleCardContainerStyle sets Margin="0,0,12,12" — ItemsWrapGrid has no
                        spacing of its own — so the visible card is 12 smaller than each number here: 280x176
                        inside a 292x188 cell.

                        Getting this wrong is not obvious, which is why it was wrong: at ItemHeight 176 the card
                        was 164 tall while the template's rows were sized for 176, so the "Played 31 min ago"
                        line lost its bottom third. It clipped rather than reflowing because that row is the
                        only Height="*" one, so it absorbed the whole 12px shortfall on its own.
                    -->
                    <ItemsWrapGrid
                        ItemHeight="188"
                        ItemWidth="292"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
    </Grid>
</Page>
