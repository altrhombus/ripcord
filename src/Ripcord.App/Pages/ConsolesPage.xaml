<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Ripcord_App.Pages.ConsolesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Ripcord_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Ripcord_App.Services"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Consoles" />
            <Button
                x:Name="AddButton"
                Grid.Column="1"
                Click="OnAddConsoleClick"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                    <TextBlock Text="Add console" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Empty state — shown when no consoles are paired.  -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE8B7;" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No consoles paired yet"
                TextAlignment="Center" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Choose “Add console” and enter the link code from your console"
                TextAlignment="Center" />
        </StackPanel>

        <!--  Paired consoles list.  -->
        <ListView
            x:Name="ConsoleList"
            Grid.Row="1"
            SelectionMode="None"
            Visibility="Collapsed">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:ConsoleListItem">
                    <Grid Padding="4,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="24"
                            Glyph="&#xE7F4;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                            <!--  Status line: a coloured dot AND the word, never colour alone. The dot updates
                                  from Checking… to Online / Resting / Offline when the probe resolves.  -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="&#x00B7;" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Host}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Click="OnConnectConsoleClick"
                                Content="Connect"
                                Style="{StaticResource AccentButtonStyle}"
                                Tag="{x:Bind Console}" />
                            <Button
                                Click="OnRemoveConsoleClick"
                                Content="Remove"
                                Tag="{x:Bind Host}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
