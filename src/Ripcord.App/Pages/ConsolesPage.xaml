<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Ripcord_App.Pages.ConsolesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ripcord_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Ripcord_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Ripcord_App.Services"
    xmlns:vm="using:Ripcord.Presentation.Consoles"
    SizeChanged="OnPageSizeChanged"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            The card. A Border in the card's own material (Ripcord.Card.xaml), and inside it one Grid that
            stacks the top highlight, the hover wash, the play wedge, the content and the overflow button.
            The vendor accent appears only on the wedge's rim and the family mark, never as a fill.

            The whole card is the primary action. That is one focus stop per console for a controller, which
            is the entire reason it is built this way rather than as a row of buttons: a pad should reach a
            console in one press, not tab past a Connect and a Remove to get to the next one. Secondary
            actions live in the overflow flyout, which the code-behind also opens on a context request and
            sets as the container's ContextFlyout, so right-click, the menu key and the pad's menu button
            all open it.
        -->
        <!--
            Bindings go through State, which is the view-model's single notifying property: the whole card is one
            immutable record, recomposed on any change. So every binding here is Mode=OneWay on a State.* path,
            and the leaf values need no notification of their own.
        -->
        <DataTemplate x:Key="ConsoleCardTemplate" x:DataType="vm:ConsoleCardViewModel">
            <Border
                Background="{ThemeResource RipcordCardFillBrush}"
                BorderBrush="{ThemeResource RipcordCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RipcordCardCornerRadius}"
                AutomationProperties.Name="{x:Bind State.AutomationName, Mode=OneWay}"
                ContextRequested="OnCardContextRequested"
                PointerCanceled="OnCardUnhighlight"
                PointerCaptureLost="OnCardUp"
                PointerEntered="OnCardHighlight"
                PointerExited="OnCardUnhighlight"
                PointerPressed="OnCardDown"
                PointerReleased="OnCardUp">

                <!--
                    Clipped to the card's own radius so the wedge can run to three of its edges without a
                    square corner poking out. Everything stacks inside this one Grid: highlight, hover wash,
                    wedge, content, overflow.
                -->
                <!--
                    RenderTransformOrigin is the centre so a press settles inwards rather than pulling toward
                    a corner. The scale itself is driven from code, gated on AppMotion.Enabled - the card is
                    on the path to play, and the standing rule there is that nothing may stand between the
                    player and the press.
                -->
                <Grid
                    CornerRadius="{StaticResource RipcordCardCornerRadius}"
                    RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="PressScale" />
                    </Grid.RenderTransform>

                    <!--  The inner top highlight. One hairline of light; see Ripcord.Card.xaml.  -->
                    <Rectangle Fill="{ThemeResource RipcordCardHighlightBrush}" />

                    <!--
                        Hover only. Focus is a ring drawn OUTSIDE the card by the system focus visual, which
                        is a different kind of mark on purpose: one wash at two opacities is
                        indistinguishable on a real screen.
                    -->
                    <!--  Faded in and out over RipcordDurationStateChange; the transition is set in code, and only with motion on.  -->
                    <Rectangle
                        x:Name="HoverWash"
                        Fill="{ThemeResource RipcordCardHoverOverlayBrush}"
                        IsHitTestVisible="False"
                        Opacity="{x:Bind State.IsHighlighted, Mode=OneWay, Converter={StaticResource ShownOpacity}}" />

                    <!--
                        The wedge, trailing edge, full height. Its width comes from CardMetrics: 72 of the
                        dense card's 280, 112 of the roomy card's 348, and 35% of the hero - wide enough
                        that it does not read as an icon that wandered right. Muted rather than removed when
                        the console did not answer; PlayWedge.xaml has the argument for that.
                    -->
                    <controls:PlayWedge
                        Width="{x:Bind State.Geometry, Mode=OneWay, Converter={StaticResource Geometry}, ConverterParameter=Wedge}"
                        HorizontalAlignment="Right"
                        Accent="{x:Bind State.Accent, Mode=OneWay, Converter={StaticResource AccentBrush}}"
                        AccentColor="{x:Bind State.Accent, Mode=OneWay, Converter={StaticResource AccentColor}}"
                        FacetFill="{ThemeResource RipcordWedgeFacetBrush}"
                        MarkFill="{ThemeResource TextFillColorPrimaryBrush}"
                        IsDown="{x:Bind State.IsPressed, Mode=OneWay}"
                        IsHot="{x:Bind State.IsPointerOver, Mode=OneWay}"
                        Muted="{x:Bind State.IsReachable, Mode=OneWay, Converter={StaticResource Not}}"
                        MutedAccent="{ThemeResource ControlStrongFillColorDisabledBrush}" />

                    <!--
                        Content sits in the leading part of the card. The right margin clears the wedge, and
                        the slack lives in the name's row, the one line that can trim whole lines away rather
                        than be cut through. On a row that can only be clipped, a short card would cut the
                        bottom third off a line of text.
                    -->
                    <Grid Margin="{x:Bind State.Geometry, Mode=OneWay, Converter={StaticResource Geometry}, ConverterParameter=Margin}">
                        <!--
                            Last-played gets its own row. The dense card's text column is 180px once the wedge
                            and the padding are taken out, which is not enough for a status word and a date side
                            by side: "Played 11 Sep 2026" comes out as "Played 11 Sep 2". The hero has room
                            for both; this does not.

                            The name and its vendor trail share the one * row, and that is what decides who loses
                            when the card is short. The card's height is set by the layout and Windows' text
                            size is not, so at 150% text a two-line name on the hero can need more than the card
                            has. Auto rows are measured first, so the status line is sized before the name is
                            offered anything, and the name trims to the lines that are left. With the name in an
                            Auto row, the status line would be the one clipped, and it is the line that says
                            whether pressing the card will work.
                        -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            Top-aligned so the trail stays under the name rather than being pushed down to meet
                            the status line; the slack falls below it.
                        -->
                        <Grid VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--
                                The name leads. Two lines at most; the overflow button lives in the wedge's corner,
                                so the name has the whole text column. The tooltip REPEATS the name rather than
                                being the only copy: touch never hovers, so anything reachable by hover alone is
                                unreachable on a handheld. Details in the overflow menu is the copy reachable by
                                finger, pad and mouse.
                            -->
                            <!--  Its own foreground, like every other line here: inherited, it would take the grid item's pointer-over colour and grey out under the pointer.  -->
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                MaxLines="2"
                                Style="{x:Bind State.Geometry, Mode=OneWay, Converter={StaticResource Geometry}, ConverterParameter=NameStyle}"
                                Text="{x:Bind State.DisplayName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{x:Bind State.DisplayName, Mode=OneWay}" />

                            <!--  The vendor trail sits with the family it names, not off on its own.  -->
                            <StackPanel
                                Grid.Row="1"
                                Margin="0,6,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <controls:FamilyMark
                                    Width="{x:Bind State.Geometry, Mode=OneWay, Converter={StaticResource Geometry}, ConverterParameter=MarkWidth}"
                                    Height="{x:Bind State.Geometry, Mode=OneWay, Converter={StaticResource Geometry}, ConverterParameter=MarkHeight}"
                                    VerticalAlignment="Center"
                                    Accent="{x:Bind State.Accent, Mode=OneWay, Converter={StaticResource AccentBrush}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{x:Bind State.Geometry, Mode=OneWay, Converter={StaticResource Geometry}, ConverterParameter=StatusStyle}"
                                    Text="{x:Bind State.Details, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!--
                            Status is the last row, the Grid after the caption below. A coloured dot AND the
                            word, never colour alone. While the probe is in flight the dot is a spinner
                            instead: "finding out" and "found out, it is nothing" are opposite answers and
                            must not look alike.
                        -->
                        <!--
                            Below hero density this row exists and the status row is beneath it; at hero
                            density it collapses and the caption moves onto the status line instead. Two
                            TextBlocks rather than one moved between rows, because a Grid.Row is not bindable
                            and a template that re-parents a child on a state change is a worse thing to own
                            than a duplicated four-line binding.

                            A console never played has no caption, and the row collapses with it rather than
                            holding an empty line: that line is height the name can use, and at 150% text it is
                            the difference between a one-line name and a two-line one. Two conditions, so two
                            elements, since a Visibility takes one converter.
                        -->
                        <Border
                            Grid.Row="1"
                            Visibility="{x:Bind State.Density, Mode=OneWay, Converter={StaticResource Density}, ConverterParameter=Stacked}">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind State.LastConnectedLabel, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind State.HasLastConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </Border>

                        <!--
                            A Grid, not a horizontal StackPanel: a StackPanel offers its children unlimited width, so
                            nothing in it can trim, and at large text "Played 2 days ago" would run on under the
                            wedge and be cut there mid-word. The caption takes what is left and trims; the dot and
                            the status word keep their size.
                        -->
                        <Grid
                            Grid.Row="2"
                            ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--
                                The ring is 16, and must not be smaller.

                                This is the stock WinUI ProgressRing - nothing here is hand-drawn - but its
                                template lays six dots around a circle and animates their size and opacity.
                                Below about sixteen pixels the dots land on fractions of a pixel, so instead
                                of reading as motion around a ring they read as a faint sparkle. The
                                control's own documented minimum is 16.

                                The dot it stands in for is 8: a resting indicator wants to be small and a
                                moving one wants to be legible, and the Grid sizes to the larger so neither
                                shifts the caption beside it.
                            -->
                            <Grid
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{x:Bind State.StatusTone, Mode=OneWay, Converter={StaticResource StatusBrush}}"
                                    Visibility="{x:Bind State.IsChecking, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="True"
                                    Visibility="{x:Bind State.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{x:Bind State.Geometry, Mode=OneWay, Converter={StaticResource Geometry}, ConverterParameter=StatusStyle}"
                                Text="{x:Bind State.StatusLabel, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />

                            <!--  The hero's copy of the caption: same fact, one line up.  -->
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{x:Bind State.Geometry, Mode=OneWay, Converter={StaticResource Geometry}, ConverterParameter=StatusStyle}"
                                Text="{x:Bind State.LastConnectedLabel, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind State.Density, Mode=OneWay, Converter={StaticResource Density}, ConverterParameter=OneLine}" />
                        </Grid>
                    </Grid>

                    <!--
                        The action names itself over the wedge, at hero density only. "Wake & play" versus
                        "Play" is the difference between expecting a stream and expecting a wait, and the
                        hero is the one card with room to say which. On a dense card the status line already
                        carries the state and the wedge already says the card launches.
                    -->
                    <!--
                        Held inside the wedge: at large text an unbounded label grows left across the diagonal.
                        MaxWidth is 65% of the wedge's width, which keeps clear of the slant, and the label wraps.
                    -->
                    <TextBlock
                        MaxWidth="{x:Bind State.Geometry, Mode=OneWay, Converter={StaticResource Geometry}, ConverterParameter=ActionLabelWidth}"
                        Margin="0,0,20,18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{x:Bind State.Geometry, Mode=OneWay, Converter={StaticResource Geometry}, ConverterParameter=StatusStyle}"
                        Text="{x:Bind State.PrimaryActionLabel, Mode=OneWay}"
                        TextAlignment="Right"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind State.Density, Mode=OneWay, Converter={StaticResource Density}, ConverterParameter=ActionLabel}" />

                    <!--
                        The overflow sits in the card's top-trailing corner, the place Windows and the console
                        shells put a tile's "more". A button nested inside a clickable item is fine: it handles
                        the pointer first, so opening the menu does not also start a connect.
                    -->
                    <Button
                        MinWidth="{StaticResource RipcordTouchTarget}"
                        MinHeight="{StaticResource RipcordTouchTarget}"
                        Margin="0,4,4,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        x:Uid="ConsolesPage_MoreOptionsConsole"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnConsoleOverflowClick"
                        Tag="{x:Bind}">
                        <FontIcon FontSize="{ThemeResource RipcordIconSizeBody}" Glyph="&#xE712;" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            The add tile, drawn as a ghost of a console card so it reads as "one more of these" rather than as
            a button that wandered into the grid.
        -->
        <DataTemplate x:Key="AddConsoleCardTemplate" x:DataType="services:AddConsolePlaceholder">
            <Grid x:Uid="ConsolesPage_AddConsole2">
                <!--
                    A dashed outline, which a Border cannot draw — StrokeDashArray belongs to Shape. So the
                    outline is a Rectangle sitting over the fill, sized to the tile.
                -->
                <!--
                    The card's own material, at lower emphasis. A flat fill beside the cards is a grey
                    rectangle sitting in a row of gradients, and looks like a different app. A ghost of a
                    card has to be made of the same stuff as the card, or it stops reading as "one more of
                    these".

                    Opacity rather than a second set of colours: one number says "this one is not real yet",
                    and it cannot drift out of step with the card the way a parallel palette would.
                -->
                <Rectangle
                    Fill="{ThemeResource RipcordCardFillBrush}"
                    Opacity="0.5"
                    RadiusX="8"
                    RadiusY="8"
                    Stroke="{ThemeResource RipcordCardStrokeBrush}"
                    StrokeDashArray="4,3"
                    StrokeThickness="1" />
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <FontIcon
                        FontSize="{ThemeResource RipcordIconSizeHero}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE710;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        x:Uid="ConsolesPage_AddConsole" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <services:ConsoleCardTemplateSelector
            x:Key="CardTemplateSelector"
            AddTemplate="{StaticResource AddConsoleCardTemplate}"
            ConsoleTemplate="{StaticResource ConsoleCardTemplate}" />

        <!--
            Strip the container's own chrome so the card is the whole visual, and stretch the content so every
            card in a row is the same height whatever its text does. The corner radius has to match the card's
            or the focus rectangle cuts its corners.
        -->
        <Style x:Key="ConsoleCardContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RipcordCardCornerRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />

            <!--
                The focus ring, on the CONTAINER, because the container is what a GridView actually focuses -
                the template's Border never receives focus from a pad at all.

                Heavier than stock (3/2 against WinUI's 2/1) because this app's standing invariant is that
                focus is legible at 2 m, and the default weight was drawn for a mouse at desk distance. It is
                still the SYSTEM focus visual rather than a border drawn in the template, which is what makes
                it correct in high contrast without anyone remembering to think about it.

                The negative margin lifts the ring clear of the card's own stroke. Adjacent, the two read as
                one thick edge, which is how a focus ring goes unnoticed on a surface that already has a
                border.
            -->
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource RipcordFocusPrimaryThickness}" />
            <Setter Property="FocusVisualSecondaryThickness" Value="{StaticResource RipcordFocusSecondaryThickness}" />
            <Setter Property="FocusVisualMargin" Value="{StaticResource RipcordFocusMargin}" />
        </Style>
    </Page.Resources>

    <!--
        The page column every other page uses, centred, with the title on its left edge. The hero stops at the
        column's width, the grid fills the column from its left edge (two cards a row), and the empty state is
        centred in it. Stretched, not centred: centred, a grid sizes to its content and the title moves with it,
        sitting in a different place for one, three and no consoles.
    -->
    <Grid
        Padding="24,16,24,0"
        MaxWidth="{StaticResource RipcordPageColumnWidthWithPadding}"
        RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

            <!--  The shortcut confirmation, below the grid.  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            No add button up here. A header button would sit about two hundred pixels from the ghost tile that
            does the same thing, and as an accent button it would make "Add console" the loudest element on a
            page whose entire point is Play: two affordances for one action, and the wrong one shouting.

            The grid does not scroll at the console counts that actually occur, so the tile is always in view.
        -->
        <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource RipcordPageTitleStyle}"
            x:Uid="ConsolesPage_Consoles" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12" Spacing="12">
            <TextBlock
                x:Name="SubtitleText"
                Style="{StaticResource RipcordSubtleCaptionStyle}"
                x:Uid="ConsolesPage_PickOneStartStreaming" />

            <!--
                An Xbox pad without GameInput does nothing at all, and nothing else on this page would say why.
                Shown only when GameInput is missing, and closed for good when the person closes it: a
                DualSense player has no use for it.
            -->
            <InfoBar
                x:Name="GameInputBar"
                x:Uid="ConsolesPage_GameInputBar"
                Closed="OnGameInputBarClosed"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />
        </StackPanel>

        <!--
            There is no separate one-console layout. The GridView below renders whenever a console is
            paired: CardMetrics returns a hero-sized cell when there is one console, and the card template
            reads its own density. The hero and the grid card are one template, so they cannot drift
            apart, and every fact the hero shows is on ConsoleCardState.

            At one console "Add another console" is a quiet HyperlinkButton, the grid's footer, rather
            than a ghost tile: a second hero-sized tile would make adding one look like half the page.
        -->
        <!--
            Confirmation for the shortcut menu item. An InfoBar rather than a dialog: writing a shortcut is
            not a decision anybody needs to acknowledge, and a modal in front of the console list would be
            three presses for a thing that already worked.
        -->
        <InfoBar
            x:Name="ShortcutBar"
            Grid.Row="3"
            Margin="0,0,0,8"
            IsOpen="False" />


        <!--
            Empty state — shown when no consoles are paired. In a scroller: at 225% text in the smallest window the
            composition is taller than the room, and unscrolled it is clipped at both ends, the mark gone and
            "Add a console" focused but off the window.
        -->
        <ScrollViewer
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <!--  As tall as the scroller shows, so the composition still centres when it fits and only scrolls when it does not.  -->
            <Grid MinHeight="{x:Bind EmptyState.ViewportHeight, Mode=OneWay}">
                <StackPanel
                    Margin="0,0,0,48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520"
                    Spacing="18">
                    <!--
                        The FULL mark, not FamilyMark. This surface is about Ripcord rather than about a console, and
                        FamilyMark is the console badge - its own XAML says the wedge is left out because the wedge is
                        the app's identity.

                        **No wordmark, deliberately.** RipcordWordmark beside this mark would be a legitimate
                        lockup rather than the bare word brand/README.md forbids, and it is left out anyway. The
                        title bar already carries the name, and this screen is a task, not an introduction,
                        which is the same reason the connect sequence is not a ceremony. About and first run are
                        the surfaces that get the lockup, because they are about Ripcord rather than about
                        getting you to a console.
                    -->
                    <controls:RipcordMark
                        Width="88"
                        Height="88"
                        WedgeFill="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource RipcordPageTitleStyle}"
                        x:Uid="ConsolesPage_FirstRunTitle"
                        TextAlignment="Center" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        x:Uid="ConsolesPage_AddConsoleOnceStays"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="EmptyStateAddButton"
                        x:Uid="ConsolesPage_EmptyStateAdd"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Click="OnAddConsoleClick"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="{ThemeResource RipcordIconSizeAction}" Glyph="&#xE710;" />
                            <TextBlock x:Uid="ConsolesPage_AddConsoleButton" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--
            GridView rather than ItemsRepeater on purpose: it is the items control with real directional-focus
            and gamepad behaviour built in, which is the whole point of the card-per-console layout here.
        -->
        <GridView
            x:Name="ConsoleGrid"
            Grid.Row="2"
            Padding="0,0,0,24"
            ContainerContentChanging="OnPrepareConsoleContainer"
            IsItemClickEnabled="True"
            ItemContainerStyle="{StaticResource ConsoleCardContainerStyle}"
            ItemClick="OnConsoleCardClick"
            ItemTemplateSelector="{StaticResource CardTemplateSelector}"
            SelectionMode="None"
            Visibility="Collapsed">
            <!--
                "Add another console" rides under the hero, 16 below the card, as part of the same centred block.
                The grid's footer, so it moves with the card wherever the card goes and is never a long way from
                the card it belongs with. Collapsed at every density but the hero, where the ghost tile does
                this job.
            -->
            <GridView.Footer>
                <HyperlinkButton
                    x:Name="HeroAddLink"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Click="OnAddConsoleClick"
                    Visibility="Collapsed"
                    x:Uid="ConsolesPage_AddAnotherConsole" />
            </GridView.Footer>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--
                        These are CELL sizes, and the cell has to contain the container's gutter margin as well
                        as the card. ConsoleCardContainerStyle sets Margin="0,0,12,12" — ItemsWrapGrid has no
                        spacing of its own — so the visible card is 12 smaller than each number here: 280x176
                        inside a 292x188 cell. These are the dense cell, and only the starting values:
                        SizePanel sets both from CardMetrics once the panel exists.

                        Getting this wrong is not obvious: at ItemHeight 176 the card is 164 tall while the
                        template's rows are sized for 176, and the card's one Height="*" row absorbs the whole
                        12px shortfall on its own, clipping rather than reflowing.
                    -->
                    <ItemsWrapGrid
                        ItemHeight="188"
                        ItemWidth="292"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
    </Grid>
</Page>
