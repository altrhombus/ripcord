<?xml version="1.0" encoding="utf-8" ?>
<!--
    Keyboard controls, as a page.

    This was a ContentDialog, and rebinding-by-capture fought the host it was in. A dialog reserves two keys:
    Escape closes it, and Enter presses the default button. Both are keys a user may legitimately want to look
    at — Enter is a DEFAULT binding here (Start) — and the second was worse than awkward. The dialog's default
    button was "Reset to defaults", so a stray Enter while capture was not armed silently wiped every binding
    the user had set. Capture only worked at all because it swallowed keys before the dialog saw them, which is
    a workaround for being in the wrong container rather than a design.

    A page reserves nothing. Enter and Escape behave like any other key, Back leaves in the ordinary way, and
    there is no button that a mis-timed press can turn into a reset. Changes save as they are made, like the
    rest of Settings — a page has no OK to press, and pretending otherwise is how a dialog's habits survive the
    move.
-->
<Page
    x:Class="Ripcord_App.Pages.KeyBindingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Ripcord_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  One binding: the action as the card's header, its keys and the Change button as its content.  -->
        <DataTemplate x:Key="BindingRowTemplate" x:DataType="local:KeyBindingRow">
            <tk:SettingsCard Header="{x:Bind ActionName}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        MinWidth="120"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind KeyNames, Mode=OneWay}"
                        TextAlignment="Right" />
                    <Button
                        AutomationProperties.Name="{x:Bind ChangeButtonName, Mode=OneWay}"
                        Click="Rebind_Click"
                        x:Uid="KeyBindingsPage_Change"
                        Tag="{x:Bind Action}" />
                </StackPanel>
            </tk:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="24,16,24,24">
        <!--  A full-width child, with the column centred inside it. Handed the column directly, the scroller lays it out at its natural width and centres THAT, so a page whose rows are narrower than the column shifted right of the others (Keyboard controls sat 40 px off Settings).  -->
        <Grid>
            <StackPanel MaxWidth="{StaticResource RipcordPageColumnWidth}" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="KeyBindingsPage_KeyboardControls" Style="{StaticResource RipcordPageTitleStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        x:Uid="KeyBindingsPage_PressChangeThenPress"
                        TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar
                    x:Name="CaptureBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational"
                    x:Uid="KeyBindingsPage_PressKey" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    x:Uid="KeyBindingsPage_EscapeFFStay"
                    TextWrapping="Wrap" />

                <!--
                    Grouped, in the row cards Settings uses: it was one flat list of 26 rows in a different style
                    from the page it opens from (showcase review, R3). The groups are built in code from one list of
                    rows, so a rebind still updates a row in place and focus stays on its Change button.
                -->
                <StackPanel x:Name="BindingGroups" Spacing="24" />

                <!--
                    Last, and not a default anything. Reset is the one destructive action here, so it sits at the
                    end of the list where reaching it is deliberate rather than at the top where a mis-aimed press
                    finds it first.
                -->
                <Button
                    x:Name="ResetButton"
                    Click="Reset_Click"
                    x:Uid="KeyBindingsPage_ResetDefaults"
                    HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
