<?xml version="1.0" encoding="utf-8" ?>
<!--
    Adding a console, as a page rather than a dialog.

    It used to be a flat six-field ContentDialog: an IP box, a Scan button, a hidden combo box of formatted
    strings, a bare "PSN account ID" field with no explanation, a link code, and a platform dropdown. It read
    as a settings form rather than as setting something up — the first thing a new user meets, asking for an
    IP address. A page hosted in the nav frame gives the room to fix that.

    CORRECTED 2026-08-05: this comment used to give a second reason — "directional gamepad focus cannot get
    inside a ContentDialog (it activates, it does not move)". The symptom was real; the attribution was not,
    and it was ours. MainWindow passed FindNextElementOptions.SearchRoot = Window.Content, and a ContentDialog
    (like a MenuFlyout, like a ComboBox dropdown) renders in the XamlRoot's popup root, which is not a
    descendant of Window.Content — so focus could not move into it. Activation kept working because
    FocusManager.GetFocusedElement is XamlRoot-wide, which is precisely what made it look like a platform
    limitation of the control. MainWindow.DirectionalRoot() now prefers the topmost open popup, so dialogs and
    flyouts are directionally navigable. Being a page is still right for the reason above — a six-field form
    is not a dialog — but it is not a workaround for a gamepad limitation, because there wasn't one.
-->
<Page
    x:Class="Ripcord_App.Pages.AddConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ripcord_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Ripcord_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Ripcord_App.Services"
    xmlns:vm="using:Ripcord.Presentation.Consoles"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  One console found on the network.  -->
        <DataTemplate x:Key="DiscoveredConsoleTemplate" x:DataType="vm:DiscoveredConsoleCard">
            <Button
                Margin="0,0,0,8"
                Padding="16,12"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind AutomationName}"
                Click="OnDiscoveredConsoleClick"
                Tag="{x:Bind}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:FamilyMark
                        Width="11"
                        Height="19"
                        VerticalAlignment="Center"
                        Accent="{x:Bind Accent, Converter={StaticResource AccentBrush}}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Details}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!--  Dot and word, as everywhere else — colour is never the only carrier.  -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{x:Bind StatusTone, Converter={StaticResource StatusBrush}}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind StatusLabel}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <!--
        Same XY focus strategy as the settings page, for the same measured reason. The controls on this page
        are different widths and alignments — a full-width results list, a pair of small left-aligned buttons,
        a text box and its confirm button — and the default rule only considers candidates that OVERLAP the
        focused element on the perpendicular axis. Where they do not overlap, focus skips them and lands
        somewhere that looks arbitrary, which is how this page was reported: "a pretty random tab index".
        RectilinearDistance ranks by distance instead, which is what "the next thing down" means to a person.
    -->
    <Grid
        Padding="24,16,24,20"
        RowSpacing="16"
        XYFocusDownNavigationStrategy="RectilinearDistance"
        XYFocusUpNavigationStrategy="RectilinearDistance">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ============ Header ============  -->
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="12">
            <TextBlock x:Uid="AddConsolePage_AddConsole" Style="{StaticResource TitleTextBlockStyle}" />
            <Grid ColumnSpacing="6" Width="220" HorizontalAlignment="Left">
                <!--
                    Three, uneven, in the mark's own proportions - 9 : 16 : 12, from brand/ripcord-tile.svg.
                    Four equal dashes were a progress bar wearing the mark's clothes. These are the trail,
                    which is the same shape the connect sequence fills in and the celebration assembles, so
                    the three moments that matter all speak the same language.
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*" />
                    <ColumnDefinition Width="16*" />
                    <ColumnDefinition Width="12*" />
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="StepDash1" Style="{StaticResource RipcordStepDashStyle}" />
                <Rectangle
                    x:Name="StepDash2"
                    Grid.Column="1"
                    Style="{StaticResource RipcordStepDashStyle}" />
                <Rectangle
                    x:Name="StepDash3"
                    Grid.Column="2"
                    Style="{StaticResource RipcordStepDashStyle}" />
            </Grid>
        </StackPanel>

        <!--  ============ Steps ============  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="720" HorizontalAlignment="Left">

                <!--  ======== 1. Which console ========  -->
                <StackPanel x:Name="FamilyPanel" Spacing="16">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition />
                        </TransitionCollection>
                    </StackPanel.Transitions>

                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        x:Uid="AddConsolePage_WhichConsoleConnecting"
                        TextWrapping="Wrap" />

                    <!--
                        The families that are actually implemented, and only those. The Xbox button used to be
                        here disabled, which is a promise the app cannot keep offered to somebody deciding
                        whether this app is for them - it says "we support Xbox" in the same breath as "not
                        for you". Gated on IsSelectable rather than deleted, so it appears the moment
                        ConsolePlatform.Lanyard works and nothing in this page changes when it does.
                    -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="XboxColumn" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="Ps5Button"
                            Height="164"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            x:Uid="AddConsolePage_Playstation"
                            Click="OnFamilyClick"
                            Tag="Ps5" />
                        <Button
                            x:Name="Ps4Button"
                            Grid.Column="1"
                            Height="164"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            x:Uid="AddConsolePage_Playstation2"
                            Click="OnFamilyClick"
                            Tag="Ps4" />
                        <Button
                            x:Name="XboxButton"
                            Grid.Column="2"
                            Height="164"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            x:Uid="AddConsolePage_Xbox"
                            Click="OnFamilyClick"
                            Tag="Lanyard" />
                    </Grid>

                    <InfoBar
                        x:Name="FamilyNote"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Informational" />
                </StackPanel>

                <!--  ======== 2. Find it ========  -->
                <StackPanel
                    x:Name="FindPanel"
                    Spacing="14"
                    Visibility="Collapsed">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition />
                        </TransitionCollection>
                    </StackPanel.Transitions>

                    <TextBlock
                        x:Name="FindHeading"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        x:Uid="AddConsolePage_LookingConsole"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="FindSubheading"
                        Style="{StaticResource RipcordSubtleCaptionStyle}"
                        x:Uid="AddConsolePage_MakeSureConsoleSwitched" />

                    <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" />

                    <ItemsControl
                        x:Name="DiscoveredList"
                        ItemTemplate="{StaticResource DiscoveredConsoleTemplate}">
                        <ItemsControl.ItemContainerTransitions>
                            <TransitionCollection>
                                <!--  Results stream in as consoles answer, so each one arrives on its own.  -->
                                <AddDeleteThemeTransition />
                            </TransitionCollection>
                        </ItemsControl.ItemContainerTransitions>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="RescanButton"
                            Click="OnRescanClick"
                            x:Uid="AddConsolePage_SearchAgain" />
                        <!--
                            A peer option, not a consolation prize: on a network that blocks broadcast this is
                            the only route, and burying it until the scan has visibly failed wastes the user's
                            time twice.
                        -->
                        <Button
                            x:Name="ManualEntryButton"
                            Click="OnManualEntryClick"
                            x:Uid="AddConsolePage_EnterAddressInstead" />
                    </StackPanel>

                    <StackPanel
                        x:Name="ManualEntryPanel"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBox
                            x:Name="HostBox"
                            x:Uid="AddConsolePage_ConsoleAddress"
                            PlaceholderText="192.168.1.20" />
                        <Button
                            x:Name="UseAddressButton"
                            Click="OnUseAddressClick"
                            x:Uid="AddConsolePage_UseAddress" />
                    </StackPanel>
                </StackPanel>

                <!--  ======== 3. Link ========  -->
                <StackPanel
                    x:Name="LinkPanel"
                    Spacing="16"
                    Visibility="Collapsed">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition />
                        </TransitionCollection>
                    </StackPanel.Transitions>

                    <TextBlock
                        x:Name="LinkHeading"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        x:Uid="AddConsolePage_LinkPcConsole"
                        TextWrapping="Wrap" />

                    <!--
                        The route, stated rather than asked.

                        It was a pair of radio buttons with their labels hard-coded in this file, past the
                        string catalogue. But the route is a MECHANISM and the player has no stake in it: a
                        casual player does not know what a pairing code is, and asking them to choose between
                        two ways of confirming a thing is the kind of question the app should answer for
                        itself. Signed in with the console on the account, it pairs; otherwise the code route
                        leads, because it needs nothing they do not already have.

                        The other route stays one quiet link away - never weighted, never explained unless
                        asked - so nobody who wants it is locked out of it.
                    -->
                    <HyperlinkButton
                        x:Name="SwitchRouteLink"
                        Click="OnSwitchRoute"
                        Visibility="Collapsed" />

                    <InfoBar
                        x:Name="AccountPairingNote"
                        IsClosable="False"
                        IsOpen="False"
                        Visibility="Collapsed" />

                    <!--
                        The sign-in invitation, on the code route only.

                        It sits BESIDE the code route rather than in front of it: the code works without an
                        account and somebody who came here to type the one on their screen should not be
                        stopped. What was missing before was any mention of the account at all when nobody
                        was signed in - every other note here asks whether the account route is available to
                        somebody already signed in, so all of them went quiet and a first-time user was left
                        hunting for their account id by hand.

                        Phrased as what it saves, never as something missing, and it carries the button that
                        takes them there - an invitation you have to go and find yourself is not one.
                    -->
                    <InfoBar
                        x:Name="SignInInvitation"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button x:Name="SignInButton" Click="OnSignInClick" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!--  Both of these belong to the code route only, and are collapsed together.  -->
                    <Border
                        x:Name="ConsoleStepsCard"
                        Padding="16,14"
                        Style="{StaticResource RipcordCardStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="AddConsolePage_Console" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="ConsoleStepsText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBox
                        x:Name="PasscodeBox"
                        MaxLength="8"
                        x:Uid="AddConsolePage_LinkCode"
                        InputScope="Number"
                        TextChanged="OnLinkInputChanged"
                        Visibility="Collapsed" />

                    <!--  Shown only when signed out. Signed in, the account ID is known and asking for it
                          again would be busywork — see AccountKnownNote below.  -->
                    <StackPanel x:Name="AccountEntryPanel" Spacing="4">
                        <TextBox
                            x:Name="AccountBox"
                            x:Uid="AddConsolePage_PlaystationNetworkAccountId"
                            InputScope="Number"
                            TextChanged="OnLinkInputChanged" />
                        <TextBlock
                            Style="{StaticResource RipcordSubtleCaptionStyle}"
                            x:Uid="AddConsolePage_NumericIdBehindPsn" />
                    </StackPanel>

                    <!--  The signed-in replacement for the box above.  -->
                    <InfoBar
                        x:Name="AccountKnownNote"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Success"
                        Visibility="Collapsed" />

                    <InfoBar
                        x:Name="LinkStatus"
                        IsClosable="False"
                        IsOpen="False" />
                </StackPanel>

                <!--  ======== 4. Pairing ========  -->
                <StackPanel
                    x:Name="PairingPanel"
                    Spacing="16"
                    Visibility="Collapsed">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition />
                        </TransitionCollection>
                    </StackPanel.Transitions>

                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        x:Uid="AddConsolePage_Pairing"
                        TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock
                        x:Name="PairingStatusText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="PairingHint"
                        Style="{StaticResource RipcordSubtleCaptionStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  ======== 5. Paired ========  -->
                <StackPanel
                    x:Name="DonePanel"
                    Spacing="16"
                    Visibility="Collapsed">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition />
                        </TransitionCollection>
                    </StackPanel.Transitions>

                    <!--
                        The celebration, and it earns the space: this happens once per console, it is the only
                        moment in the flow the player did something that could have failed, and the reward is
                        the reason they installed the app.

                        The mark at hero size rather than a green check glyph. A check says "the operation
                        succeeded"; the mark says "this is now a Ripcord console", which is the thing that
                        actually happened. And it is the same shape the step dashes have been filling in and
                        the connect sequence assembles, so by the time somebody presses Play they have seen
                        it three times without being taught anything.

                        "Paired." with a period, never "Success!" - the app is stating a fact, not
                        congratulating anybody.
                    -->
                    <controls:RipcordMark
                        Width="96"
                        Height="96"
                        HorizontalAlignment="Left"
                        WedgeFill="{ThemeResource TextFillColorPrimaryBrush}" />

                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        x:Uid="AddConsolePage_Paired" />

                    <TextBlock
                        x:Name="DoneSubtext"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <!--
                        Naming happens here rather than up front: at this point the console is already paired,
                        so this is a flourish the user can skip, not another field standing between them and
                        the thing working.
                    -->
                    <StackPanel Spacing="4">
                        <TextBox x:Uid="AddConsolePage_WhatShouldWeCall" x:Name="NameBox" />
                        <TextBlock
                            Style="{StaticResource RipcordSubtleCaptionStyle}"
                            x:Uid="AddConsolePage_HandyWhenHaveMore" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  ============ Footer ============  -->
        <Grid Grid.Row="2" MaxWidth="720" HorizontalAlignment="Left" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                Click="OnBackClick"
                x:Uid="AddConsolePage_Back" />
            <Button
                x:Name="PrimaryButton"
                Grid.Column="1"
                Click="OnPrimaryClick"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" />
            <Button
                x:Name="SecondaryButton"
                Grid.Column="2"
                Click="OnSecondaryClick"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
