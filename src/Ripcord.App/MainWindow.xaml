<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Ripcord_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Ripcord_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Ripcord"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <!--  Collapsed while a stream is running, so the video is genuinely immersive.  -->
            <RowDefinition x:Name="TitleBarRow" Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Ripcord"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The navigation surface is deliberately small. It previously listed Consoles / Connect / Session /
            About, which was the developer's model rather than the product's: "Session" was clickable with no
            console selected, and "Connect" was a placeholder while pairing actually happened in a dialog on the
            Consoles page. A stream is something you start *from* a console, not a destination you navigate to.
        -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    AutomationProperties.Name="Consoles"
                    Content="Consoles"
                    IsSelected="True"
                    Tag="consoles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.Name="About"
                    Content="About"
                    Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>

        <!--
            The stream lives in its own layer on top of the chrome rather than inside the NavigationView.
            Hosting it as a normal navigation destination meant it inherited the NavigationView content area's
            1px border and rounded top-left corner, which showed as a thin light line along the top and left
            edges of the video. It is also the more honest model: a running stream is not a place you navigate
            to inside app furniture, it takes over the window.
        -->
        <Frame
            x:Name="StreamFrame"
            Grid.Row="1"
            Background="Black"
            Visibility="Collapsed" />
    </Grid>
</Window>
