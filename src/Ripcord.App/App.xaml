<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Ripcord_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ripcord_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Ripcord's shared vocabulary: cards, chips, pills, vendor accents. Must come after
                     XamlControlsResources, since its styles are BasedOn the stock text ramp. -->
                <ResourceDictionary Source="ms-appx:///Styles/Ripcord.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
