<?xml version="1.0" encoding="utf-8" ?>
<!--
    The Ripcord mark: a play wedge with three trailing dashes, one per console family.

    Distinct from FamilyMark, and the distinction matters. FamilyMark is the CONSOLE badge - the trail alone,
    in one vendor's accent - and its own XAML says the wedge is left out deliberately, because the wedge is
    the app's identity and stamping the full logo on every console card would say the wrong thing. This is
    that full logo, for the places that are about Ripcord rather than about a console: first run, and the
    pairing celebration.

    Geometry is brand/ripcord-mark-ondark.svg exactly, placed with the transform generate-assets.ps1 applies
    when it composes the tile - the mark is drawn in a 64-unit box, scaled to 72% and centred, which is what
    keeps it surviving an adaptive-icon crop. Do not re-draw it by eye; brand/*.svg is the source of truth and
    generate-assets.ps1 renders from the same files.

    The dashes are uneven and right-aligned BECAUSE OF their relationship to the wedge - brand/README.md is
    explicit that a tidy trio reads as a fast-forward button and that the raggedness belongs on the outside
    edge. Laid out any other way both reasons are gone and the middle segment is 70% wider than the first for
    a reason nobody can recover. Do not tidy the lengths.
-->
<UserControl
    x:Class="Ripcord_App.Controls.RipcordMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Decorative: every surface that uses this states the app's name in words beside it, and a screen
        reader announcing the logo as well would only add a second voice saying "Ripcord".
    -->
    <Viewbox
        AutomationProperties.AccessibilityView="Raw"
        Stretch="Uniform">
        <Canvas Width="64" Height="64">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <TranslateTransform X="-30.5" Y="-32" />
                    <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                    <TranslateTransform X="32" Y="32" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!--
                The wedge, in the app's own colour rather than a vendor's. Set by the caller so it can be a
                ThemeResource and track the theme: brand/README.md gives #FFFFFF on dark grounds and #17191D
                on light, which is what the ordinary foreground brush already resolves to.
            -->
            <!--
                Filled, not filled-and-stroked. The rounded corners used to come from a 6px round-joined
                stroke in the same brush as the fill. In light theme that brush is translucent, so the band
                where stroke and fill overlap was drawn twice and the mark wore a dark outline (visual audit,
                2026-10-08). This outline is the same shape - the triangle grown by the stroke's radius,
                corners rounded at 3 - drawn once.
            -->
            <Path
                x:Name="WedgePart"
                Data="M 26,17 A 3,3 0 0 1 30.59,14.456 L 54.59,29.456 A 3,3 0 0 1 54.59,34.544 L 30.59,49.544 A 3,3 0 0 1 26,47 Z"
                Fill="{x:Bind WedgeFill, Mode=OneWay}">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="WedgeShift" />
                </Path.RenderTransform>
            </Path>

            <!--  The trail. Three dashes, three families, in brand order.  -->
            <Rectangle
                x:Name="TrailOne"
                Canvas.Left="12"
                Canvas.Top="18"
                Width="9"
                Height="7"
                Fill="{ThemeResource RipcordXboxAccentBrush}"
                RadiusX="3.5"
                RadiusY="3.5">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="TrailOneShift" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle
                x:Name="TrailTwo"
                Canvas.Left="5"
                Canvas.Top="28.5"
                Width="16"
                Height="7"
                Fill="{ThemeResource RipcordPlayStationAccentBrush}"
                RadiusX="3.5"
                RadiusY="3.5">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="TrailTwoShift" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle
                x:Name="TrailThree"
                Canvas.Left="9"
                Canvas.Top="39"
                Width="12"
                Height="7"
                Fill="{ThemeResource RipcordNintendoAccentBrush}"
                RadiusX="3.5"
                RadiusY="3.5">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="TrailThreeShift" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>
    </Viewbox>
</UserControl>
