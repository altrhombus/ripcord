<?xml version="1.0" encoding="utf-8" ?>
<!--
    The connect progress indicator: the Ripcord mark, assembling.

    It replaced three horizontal dashes laid out left to right and lit in turn. That was a progress bar
    wearing the mark's dashes, and it threw away the only thing that made the shape mean anything - the
    dashes are uneven and right-aligned BECAUSE OF their relationship to the wedge. brand/README.md is
    explicit: a tidy trio reads as a fast-forward button, and the raggedness belongs on the outside edge.
    Laid out in a row with no wedge, both reasons are gone and the middle segment is 70% wider than the first
    for a reason nobody can recover.

    So this is the mark itself, with the wedge lit from the first moment and each dash lighting as its phase
    is reached. Progress is the trail filling in behind something that has already launched, which is what
    the mark has always meant.

    Geometry is brand/ripcord-tile.svg exactly, transform included. The dashes are in the CONSOLE's accent
    rather than the three family colours, because this is one console's connect and not the app's logo -
    resolved through AccentResources, so high contrast drops it to a system brush rather than painting
    decorative colour where the palette forbids it.

    Still deliberately NOT a percentage. Where you are is knowable; how long it will take is not, and a bar
    that implied otherwise would be inventing a number to look reassuring.
-->
<UserControl
    x:Class="Ripcord_App.Controls.ConnectMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Decorative. The status line beside it says what is happening in words, and a screen reader announcing
        a logo as well would add nothing a listener can act on.
    -->
    <Viewbox
        AutomationProperties.AccessibilityView="Raw"
        Stretch="Uniform">
        <Canvas Width="64" Height="64">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <TranslateTransform X="-30.5" Y="-32" />
                    <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                    <TranslateTransform X="32" Y="32" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!--  Lit from the first moment: something has launched, and the trail is what follows.  -->
            <Path
                x:Name="Wedge"
                Data="M 29,17 L 53,32 L 29,47 Z"
                StrokeLineJoin="Round"
                StrokeThickness="6" />

            <Rectangle
                x:Name="DashOne"
                Canvas.Left="12"
                Canvas.Top="18"
                Width="9"
                Height="7"
                RadiusX="3.5"
                RadiusY="3.5" />
            <Rectangle
                x:Name="DashTwo"
                Canvas.Left="5"
                Canvas.Top="28.5"
                Width="16"
                Height="7"
                RadiusX="3.5"
                RadiusY="3.5" />
            <Rectangle
                x:Name="DashThree"
                Canvas.Left="9"
                Canvas.Top="39"
                Width="12"
                Height="7"
                RadiusX="3.5"
                RadiusY="3.5" />
        </Canvas>
    </Viewbox>
</UserControl>
