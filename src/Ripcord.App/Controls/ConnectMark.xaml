<?xml version="1.0" encoding="utf-8" ?>
<!--
    The connect progress indicator: the Ripcord mark, assembling.

    The wedge is lit from the first moment and each dash lights as its phase is reached: progress is the
    trail filling in behind something that has already launched. An unreached dash is dim, not absent, so
    the shape is whole from the first frame.

    The dashes keep the mark's arrangement and are not laid out in a row. They are uneven and right-aligned
    BECAUSE OF their relationship to the wedge: brand/README.md is explicit that a tidy trio reads as a
    fast-forward button and that the raggedness belongs on the outside edge. In a row with no wedge both
    reasons are gone, and the middle dash is 78% wider than the first for no visible reason.

    Geometry is brand/ripcord-mark-ondark.svg exactly, placed with the tile transform generate-assets.ps1
    applies (72%, centred). The dashes are in the CONSOLE's accent
    rather than the three family colours, because this is one console's connect and not the app's logo. The
    caller supplies the brush already resolved (SessionPage uses AccentResources), so high contrast gets a
    system brush rather than decorative colour where the palette forbids it.

    Deliberately NOT a percentage. Where you are is knowable; how long it will take is not, and a bar
    that implied otherwise would be inventing a number to look reassuring.
-->
<UserControl
    x:Class="Ripcord_App.Controls.ConnectMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Decorative. The status line beside it says what is happening in words, and a screen reader announcing
        a logo as well would add nothing a listener can act on.
    -->
    <Viewbox
        AutomationProperties.AccessibilityView="Raw"
        Stretch="Uniform">
        <Canvas Width="64" Height="64">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <TranslateTransform X="-30.5" Y="-32" />
                    <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                    <TranslateTransform X="32" Y="32" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!--  Lit from the first moment: something has launched, and the trail is what follows.  -->
            <!--
                Filled, with no stroke. The outline is the mark's triangle grown by 3 with its corners
                rounded at 3, which is the shape a 6px round-joined stroke gives, drawn once. A stroke in
                the fill's brush would paint the band where the two overlap twice, and where that brush is
                translucent (the light theme) the mark would wear a dark outline.
            -->
            <Path
                x:Name="Wedge"
                Data="M 26,17 A 3,3 0 0 1 30.59,14.456 L 54.59,29.456 A 3,3 0 0 1 54.59,34.544 L 30.59,49.544 A 3,3 0 0 1 26,47 Z" />

            <Rectangle
                x:Name="DashOne"
                Canvas.Left="12"
                Canvas.Top="18"
                Width="9"
                Height="7"
                RadiusX="3.5"
                RadiusY="3.5" />
            <Rectangle
                x:Name="DashTwo"
                Canvas.Left="5"
                Canvas.Top="28.5"
                Width="16"
                Height="7"
                RadiusX="3.5"
                RadiusY="3.5" />
            <Rectangle
                x:Name="DashThree"
                Canvas.Left="9"
                Canvas.Top="39"
                Width="12"
                Height="7"
                RadiusX="3.5"
                RadiusY="3.5" />
        </Canvas>
    </Viewbox>
</UserControl>
