<?xml version="1.0" encoding="utf-8" ?>
<!--
    The card's material: the gradient, the stroke, the top highlight, and the focus ring.

    Split from Surfaces because this is the first dictionary in the app with THEME DICTIONARIES. Everything
    else resolves theme through {ThemeResource} onto a system brush; the card cannot, because the gradient is
    Ripcord's own and Windows has no stock brush for it.

    > The gradient's direction and its ratio are Ripcord's; its lightness belongs to the theme.

    In dark theme the card runs deeper than the Mica ground (#23272E to #12151A, the app tile's own values).
    In light theme it runs LIGHTER than the ground, so it reads as raised paper rather than a hole cut in the
    page. A dark card on a light desktop was drawn, considered and rejected: it overrules a preference the
    user stated to the operating system, which is not a thing an app gets to do for style.

    High contrast takes neither. Every brush below falls back to a system colour there, because a gradient is
    decoration and high contrast is the one theme where decoration is not permitted to carry meaning. What
    replaces it is the stroke, which high contrast draws in the system window text colour and which is
    therefore the only card edge that survives.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!--  Dark. The tile's own two values, in the tile's own direction.  -->
        <ResourceDictionary x:Key="Default">
            <LinearGradientBrush x:Key="RipcordCardFillBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#23272E" />
                <GradientStop Offset="1" Color="#12151A" />
            </LinearGradientBrush>

            <!--
                The inner top highlight: one hairline of light along the top edge, which is what stops a dark
                card reading as a cut-out. Drawn as a gradient that is opaque for the first pixel or so and
                transparent immediately after, rather than as a second Border, so it costs no layout.
            -->
            <LinearGradientBrush x:Key="RipcordCardHighlightBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#26FFFFFF" />
                <GradientStop Offset="0.04" Color="#00FFFFFF" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="RipcordCardStrokeBrush" Color="#2EFFFFFF" />

            <!--  The pointer wash. Lifts the card a little; deliberately quieter than focus. See below.  -->
            <SolidColorBrush x:Key="RipcordCardHoverOverlayBrush" Color="#16FFFFFF" />
        </ResourceDictionary>

        <!--  Light. Lighter than the ground, not darker. The whole point of the rule.  -->
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="RipcordCardFillBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="1" Color="#EEF0F4" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="RipcordCardHighlightBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#B3FFFFFF" />
                <GradientStop Offset="0.04" Color="#00FFFFFF" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="RipcordCardStrokeBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="RipcordCardHoverOverlayBrush" Color="#12000000" />
        </ResourceDictionary>

        <!--
            High contrast. No gradient, no wash, no hairline: the card is its stroke and nothing else.

            These alias the STOCK card brushes rather than naming SystemColor* keys directly. WinUI already
            remaps CardBackgroundFillColorDefaultBrush and CardStrokeColorDefaultBrush to the right system
            colours under high contrast, so aliasing gets the same result through a key this repository has
            used for a year. Naming a system colour by hand buys nothing and risks a key that resolves
            nowhere - which in a theme dictionary is a crash in the one theme nobody can casually test.
        -->
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="RipcordCardFillBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="RipcordCardStrokeBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <SolidColorBrush x:Key="RipcordCardHighlightBrush" Color="Transparent" />
            <SolidColorBrush x:Key="RipcordCardHoverOverlayBrush" Color="Transparent" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!--
        The focus ring, and why it is these numbers.

        Hover and focus were the same picture until 2026-09-20: both ran through one IsHighlighted flag onto
        one accent wash, moving it from 0.10 to 0.22 opacity on a gradient that fades out at 90%. That is a
        tint delta rather than an outline, it was invisible on a real screen, and in high contrast the wash
        was suppressed to zero, leaving nothing at all. A pad user could not tell where focus was.

        So the two states are now different KINDS of thing, not two strengths of one thing:

          hover  a wash over the card - pointer feedback, low stakes, and it follows the mouse
          focus  a ring drawn outside the card - the keyboard and pad answer to "where am I?"

        The ring is the system focus visual rather than something drawn here, which is what makes it correct
        in high contrast for free: Windows draws it in the system focus colour and it cannot be suppressed by
        an app that forgot to think about it. What IS set here is its weight - 3px primary against a 2px
        secondary, against WinUI's 2 and 1 - because the standing invariant for this app is that focus is
        legible at 2 m, and the stock weight was drawn for a mouse at desk distance.

        The negative margin lifts the ring off the card's own stroke. Without it the two lines sit adjacent
        and read as one thick edge, which is the failure mode that makes a focus ring easy to miss on a
        surface that already has a border.
    -->
    <Thickness x:Key="RipcordFocusPrimaryThickness">3</Thickness>
    <Thickness x:Key="RipcordFocusSecondaryThickness">2</Thickness>
    <Thickness x:Key="RipcordFocusMargin">-4</Thickness>

</ResourceDictionary>
