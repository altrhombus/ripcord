<?xml version="1.0" encoding="utf-8" ?>
<!--
    The type ramp.

    Every role is BasedOn a stock WinUI text style and overrides as little as possible. That inheritance is
    not politeness — it is what keeps Ripcord's text tracking the system ramp when Windows changes it, and
    what makes text scaling reachable, since the stock styles resolve their size through theme resources the
    scale factor can rewrite.

    So: no FontSize setter in this file. A role that needs a different size needs a different stock style to
    sit on, not a literal. (The app currently has no FontSize literal outside a FontIcon, and there is a test
    to be written that keeps it that way.)

    No Margin setters either. See the vertical-rhythm rule in Ripcord.Tokens.xaml — a margin on a text style
    is invisible at the call site and is how this app grew two section-header styles differing only in their
    bottom margin.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        A group heading above a run of cards. From AboutPage.SectionHeaderStyle / SettingsPage.GroupHeaderStyle.

        BasedOn, not a Setter for Style: setting the Style property from inside a Style is invalid XAML and
        throws when the page is parsed. SettingsPage records having learned that the hard way — it took the
        whole app down on navigation rather than failing visibly on one page.

        The "0,16,0,4" margin this used to carry is gone. It was the entire difference between the two page
        copies this style exists to replace (About wanted 0,16,0,0), so with it removed they are the same
        style and the merge becomes a deletion rather than a negotiation. Callers space their own children.
    -->
    <Style
        x:Key="RipcordSectionHeaderStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Explanatory line under a heading — the "why this page exists" sentence.  -->
    <Style
        x:Key="RipcordSubtleCaptionStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        The label inside a pill. Small, semi-bold and letter-spaced, because a pill is read as a token rather
        than as prose — at caption size the tracking is what stops "ZERO-COPY" reading as one long word.
    -->
    <Style
        x:Key="RipcordPillTextStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--  The same label on an accent fill, where the foreground has to come from the accent pair.  -->
    <Style
        x:Key="RipcordAccentPillTextStyle"
        BasedOn="{StaticResource RipcordPillTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <!--
        ================================================================================================
        Label/value rows

        Two sizes, because there are two audiences and the difference is not decoration.

        The DETAIL pair is body-sized, for facts a person reads once and may need to copy — the About
        page's device table. The INSTRUMENT pair is caption-sized, for a dense readout scanned at a
        glance while something else has the attention: the diagnostics overlay.

        They were previously two page-local pairs sharing the names RowLabelStyle and RowValueStyle, in
        AboutPage and SessionPage, with entirely different definitions. That is worse than duplication —
        identical names for different things means neither page can be read without checking which one
        you are in, and moving markup between them silently restyles it.
        ================================================================================================
    -->
    <!--
        These two carry a Margin, which the rhythm rule otherwise forbids, and the distinction is worth stating
        because it decides every future case: this is CELL INSET, not spacing between siblings. A XAML Grid has
        no per-cell padding, so a table cell's inset has literally nowhere else to live — whereas rhythm between
        siblings always has a container that can express it, which is why it must.
    -->
    <Style
        x:Key="RipcordDetailLabelStyle"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="16,11,16,11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="RipcordDetailValueStyle"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0,11,16,11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />

        <!--  Selectable because the whole point of the device table is pasting it into a bug report.  -->
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style
        x:Key="RipcordInstrumentLabelStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />

        <!--  Top, not centre: a wrapped value must not drag its label down the row.  -->
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style
        x:Key="RipcordInstrumentValueStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        A group label inside an instrument panel — the diagnostics overlay's DEVICE / VIDEO / LINK rules.
        Distinct from the section header above: that one titles a page's content at body weight, this one
        divides a dense readout and is deliberately quieter than the values it introduces, which is what the
        wide tracking buys.
    -->
    <Style
        x:Key="RipcordInstrumentGroupStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

</ResourceDictionary>
