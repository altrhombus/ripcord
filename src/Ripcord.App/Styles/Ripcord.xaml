<?xml version="1.0" encoding="utf-8" ?>
<!--
    The app's shared visual vocabulary.

    Until this file existed there was nothing shared to be consistent *with*: App.xaml merged only
    XamlControlsResources, so the same card, chip and pill were re-declared inline in AboutPage,
    SettingsPage and SessionPage, drifting a little each time. Every value here is lifted verbatim from one
    of those pages rather than re-designed, so adopting a key is a no-op visually — the point is to stop the
    fourth copy being written, not to restyle what already ships.

    Pages are migrated to these keys opportunistically. About and Settings deliberately still carry their
    own copies; changing three good pages at the same time as building two new ones would make the diff
    unreadable.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================================================
        Corner radii

        The vocabulary already in use across the app, named so the next surface picks from the set
        rather than inventing a seventh value. 4 = tag, 8 = card, 10 = chip/pill, 12 = panel/overlay,
        16 = hero.
        ============================================================================================
    -->
    <CornerRadius x:Key="RipcordTagCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="RipcordCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="RipcordPillCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="RipcordPanelCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="RipcordHeroCornerRadius">16</CornerRadius>

    <!--
        ============================================================================================
        Vendor accents

        The three dash colours of the Ripcord mark, one per console vendor — blue PlayStation, green
        Xbox, red Nintendo. See brand/README.md, which is the source of truth for both the values and
        the mapping.

        These are Ripcord's own values, chosen to read as "three platforms". They are NOT sampled from
        any console maker's brand guide, and must never be "corrected" toward an official one — the
        association is nominative, the same latitude NOTICE takes with the word "PS5", and it only holds
        while the values stay ours.

        Fixed in both themes on purpose: they are brand identity, not chrome, and both remain legible
        against Mica in light and dark. They are used for marks and low-opacity washes only, never as a
        text or an icon-on-fill colour, so they carry no contrast requirement of their own — which is
        also why colour is never the sole carrier of meaning anywhere it appears.
    -->
    <Color x:Key="RipcordPlayStationAccentColor">#2D7DF6</Color>
    <Color x:Key="RipcordXboxAccentColor">#2FBF5B</Color>
    <Color x:Key="RipcordNintendoAccentColor">#F0433A</Color>

    <SolidColorBrush x:Key="RipcordPlayStationAccentBrush" Color="{StaticResource RipcordPlayStationAccentColor}" />
    <SolidColorBrush x:Key="RipcordXboxAccentBrush" Color="{StaticResource RipcordXboxAccentColor}" />
    <SolidColorBrush x:Key="RipcordNintendoAccentBrush" Color="{StaticResource RipcordNintendoAccentColor}" />

    <!--
        ============================================================================================
        Surfaces
        ============================================================================================
    -->

    <!--  A content card. From AboutPage.CardStyle / SettingsPage.SettingsCardStyle, which were identical.  -->
    <Style x:Key="RipcordCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RipcordCardCornerRadius}" />
    </Style>

    <!--  A small rounded label for a single fact: version, licence, support level. From AboutPage.ChipStyle.  -->
    <Style x:Key="RipcordChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RipcordPillCornerRadius}" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  A state pill. From SessionPage.CapabilityPillStyle — tighter padding and a dimmer fill than a chip.  -->
    <Style x:Key="RipcordPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RipcordPillCornerRadius}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="RipcordAccentPillStyle"
        BasedOn="{StaticResource RipcordPillStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>

    <Style
        x:Key="RipcordPillTextStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="RipcordAccentPillTextStyle"
        BasedOn="{StaticResource RipcordPillTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <!--
        ============================================================================================
        Text
        ============================================================================================
    -->

    <!--
        A group heading above a run of cards. From AboutPage.SectionHeaderStyle / SettingsPage.GroupHeaderStyle.

        BasedOn, not a Setter for Style: setting the Style property from inside a Style is invalid XAML and
        throws when the page is parsed. SettingsPage records having learned that the hard way — it took the
        whole app down on navigation rather than failing visibly on one page.
    -->
    <Style
        x:Key="RipcordSectionHeaderStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0,16,0,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Explanatory line under a heading — the "why this page exists" sentence.  -->
    <Style
        x:Key="RipcordSubtleCaptionStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
