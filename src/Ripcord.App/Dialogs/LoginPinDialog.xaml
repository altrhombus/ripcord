<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Ripcord_App.Dialogs.LoginPinDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="LoginPinDialog_EnterConsoleLoginPasscode"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    mc:Ignorable="d">

    <StackPanel MinWidth="360" Spacing="12">
        <TextBlock
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            x:Uid="LoginPinDialog_ConsoleSignedOutNeeds" />

        <!--  Shown only on a re-prompt, after the console rejected the previous passcode.  -->
        <TextBlock
            x:Name="RetryNotice"
            Visibility="Collapsed"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            TextWrapping="Wrap"
            x:Uid="LoginPinDialog_PasscodeWasnTAccepted" />

        <!--  Digits only, submits on the last one. MaxLength is not fixed to 4 because the passcode length is
              user-configured on the console (4 is the common case); the Sign in button enables at >= 4.  -->
        <TextBox
            x:Name="PinBox"
            x:Uid="LoginPinDialog_LoginPasscode"
            PlaceholderText="••••"
            InputScope="NumericPin"
            MaxLength="16"
            TextChanged="OnPinChanged" />

        <!--
            Shown only with a pad attached: its buttons type the passcode as they do on the console, and the
            legend is the console's own table of which button is which digit. Filled from code, from the same
            table the pad is read with (HalyardPasscodePad.Keys), named for the pad in hand.
        -->
        <StackPanel x:Name="PadSection" Visibility="Collapsed" Spacing="8">
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                x:Uid="LoginPinDialog_PadHint" />
            <Grid x:Name="PadLegend" ColumnSpacing="6" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            </Grid>
            <TextBlock
                x:Name="PadActions"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
