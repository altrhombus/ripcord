<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Ripcord_App.Dialogs.AccountSignInDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Sign in to PlayStation Network"
    CloseButtonText="Cancel"
    mc:Ignorable="d">

    <!--  Sized generously: this hosts someone else's sign-in page, including a QR code for the passkey flow,
          and a cramped web view is the difference between a usable page and one the user scrolls sideways.  -->
    <Grid Width="520" Height="560" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Worth stating plainly: the page below is Sony's, not ours, and nothing typed into it passes
              through Ripcord. Users are right to be suspicious of an app-hosted password box.  -->
        <TextBlock
            Grid.Row="0"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="This is Sony's own sign-in page. Ripcord never sees your password — it receives only a sign-in token when you're done." />

        <Grid Grid.Row="1">
            <controls:WebView2 x:Name="Browser" NavigationStarting="OnNavigationStarting" />

            <!--  Covers the web view until the first page paints, so the dialog never opens on a white void.  -->
            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing IsActive="True" Width="32" Height="32" />
                <TextBlock
                    x:Name="LoadingText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Text="Opening the sign-in page…" />
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
