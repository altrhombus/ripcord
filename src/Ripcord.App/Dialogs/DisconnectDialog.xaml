<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Ripcord_App.Dialogs.DisconnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="DisconnectDialog_DisconnectFromConsole"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel MinWidth="360" Spacing="16">
        <TextBlock
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            x:Uid="DisconnectDialog_GameKeepsRunningConsole" />

        <!--  Default follows the "Rest console when I disconnect" setting; the checkbox lets this one
              disconnect differ without changing the standing preference.  -->
        <CheckBox
            x:Name="RestCheckBox"
            x:Uid="DisconnectDialog_PutConsoleIntoRest" />
    </StackPanel>
</ContentDialog>
