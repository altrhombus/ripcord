// The Swift layer over the Rust engine, shared by the lab, the Mac app and its extensions, and the mobile app.
// One framework for every Apple platform the engine is built for (docs/ios-plan.md).

PRODUCT_NAME = RipcordKit
PRODUCT_BUNDLE_IDENTIFIER = io.github.altrhombus.Ripcord.Kit
GENERATE_INFOPLIST_FILE = YES
DEFINES_MODULE = YES
SKIP_INSTALL = YES
// Static for now, so a command-line tool can link it without an rpath. The app may want it dynamic,
// shared between the app and its extensions; that is a one-line change here.
MACH_O_TYPE = staticlib

// The engine phase runs cargo, which reads and writes under engine/, outside what the sandbox allows.
ENABLE_USER_SCRIPT_SANDBOXING = NO

SUPPORTED_PLATFORMS = macosx iphoneos iphonesimulator appletvos appletvsimulator
SDKROOT = auto
TARGETED_DEVICE_FAMILY = 1,2,3
SUPPORTS_MACCATALYST = NO
