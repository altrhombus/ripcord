// The app for iPhone, iPad and Apple TV (docs/ios-plan.md). One target, three device families, over the same
// RipcordKit and engine as the Mac app. Scaffolding: it builds for all three, device and simulator, and has
// not been run on any of them.

PRODUCT_NAME = Ripcord
// The Mac app's identifier, so the three can one day be one purchase; different platforms, so no clash.
PRODUCT_BUNDLE_IDENTIFIER = io.github.altrhombus.Ripcord
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator appletvos appletvsimulator
SDKROOT = auto
TARGETED_DEVICE_FAMILY = 1,2,3
SUPPORTS_MACCATALYST = NO
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Ripcord
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.games
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Ripcord finds and streams from PlayStation consoles on your network.
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
// The icon for iPhone and iPad (RipcordMobile/Ripcord.icon, generated by brand/generate-macos-icon.py). Apple TV
// needs an App Icon & Top Shelf Image collection instead, still to do (docs/ios-plan.md).
ASSETCATALOG_COMPILER_APPICON_NAME[sdk=iphone*] = Ripcord
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) RIPCORD_MOBILE
