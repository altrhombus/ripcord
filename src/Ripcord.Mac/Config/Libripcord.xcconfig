// libripcord, compiled from where it lives, plus the Mac's platform seam (Libripcord/).

PRODUCT_NAME = Libripcord
SKIP_INSTALL = YES

// CryptoKit supplies the ECDH backend (RipcordKit/Crypto/CryptoKitECDH.swift); see rc_ecdh.h.
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) RC_ECDH_EXTERNAL_BACKEND=1

// The core's own warning discipline, from libripcord/tests/Makefile, as errors.
WARNING_CFLAGS = -Wall -Wextra -Wshadow -Wconversion -Wsign-conversion
GCC_TREAT_WARNINGS_AS_ERRORS = YES

// The constants script reads the committed bundle and writes into DERIVED_FILE_DIR, both declared.
ENABLE_USER_SCRIPT_SANDBOXING = NO
