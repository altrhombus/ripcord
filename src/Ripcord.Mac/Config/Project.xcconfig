// Settings every target shares. Target files include nothing; Xcode layers them over this one.

RIPCORD_REPO_ROOT = $(SRCROOT)/../..

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
// Apple Silicon only: see docs/macos-plan.md, "Decisions".
ARCHS = arm64
SWIFT_VERSION = 6.0
CLANG_ENABLE_MODULES = YES

// The protocol engine is the Rust one (docs/engine-plan.md, Phase 3), reached through its generated header.
SWIFT_INCLUDE_PATHS = $(inherited) $(SRCROOT)/RipcordEngine/include

// RipcordKit's "Build the Rust engine" phase runs cargo; every executable that links RipcordKit links the
// static archive by full path, because cargo writes a dylib of the same name beside it and -l would
// prefer that. Static-library targets link with libtool, which does not read OTHER_LDFLAGS.
RIPCORD_ENGINE = $(RIPCORD_REPO_ROOT)/engine
// The shipping library: no test-support exports. RipcordKitTests.xcconfig points at the test build instead.
RIPCORD_ENGINE_LIB = $(RIPCORD_ENGINE)/target/shipping/release/libripcord.a
OTHER_LDFLAGS = $(inherited) $(RIPCORD_ENGINE_LIB)

// Ad hoc signing until distribution is set up (docs/macos-plan.md, step 9).
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual

// The app group the widgets read the paired consoles through (Shared/ConsoleSnapshot.swift). Claiming a group
// needs a provisioning profile, which an ad hoc build cannot have, so it is off here and a signed build turns
// it on: RIPCORD_APP_GROUP = YES with a team and a profile that carries the group. With it off the widget
// builds sandboxed and shows the way into the app, and the app writes no snapshot.
RIPCORD_APP_GROUP = NO
