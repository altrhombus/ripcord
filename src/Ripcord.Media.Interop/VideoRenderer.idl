// GpuSelection is declared in VideoCapabilities.idl. Each .idl in this project is compiled independently, so
// referencing a type from another one requires an explicit import even within the same namespace.
import "VideoCapabilities.idl";

namespace Ripcord.Media.Interop
{
    // The D3D12 renderer: a swap-chain-for-composition present surface, the Media Foundation decoder
    // that feeds it, and the present paths. The managed side associates SwapChainPointer with a XAML
    // SwapChainPanel (via ISwapChainPanelNative), which keeps this component free of any WinUI
    // dependency.
    [default_interface]
    runtimeclass VideoRenderer
    {
        VideoRenderer();

        // Create the D3D12 device, command queue, and composition swap chain at the given size, on the adapter
        // implied by gpuSelection. specificLuid is used only when gpuSelection is Specific (0 otherwise).
        // windowHandle is the HWND the video will be shown in, which decides whose HDR state counts; 0 means
        // the primary monitor. See PresentingDisplay.h.
        void Initialize(UInt32 width, UInt32 height, GpuSelection gpuSelection, UInt64 specificLuid,
            UInt64 windowHandle);

        // Re-read the HDR state of the display the window is on, after the window moved to another monitor.
        // If the answer changed, the back buffer switches format (10-bit for an HDR display, 8-bit otherwise)
        // and the next decoded frame rebuilds the video processor with the new output colour space, so a
        // dragged session presents as one started on that display would.
        void RefreshPresentingDisplay(UInt64 windowHandle);

        // Description of the adapter actually chosen, for the diagnostics overlay and settings UI. Empty until
        // Initialize succeeds.
        String ActiveAdapterDescription{ get; };

        // True when the graphics device has been lost (driver update, TDR, eGPU unplug). Nothing will render
        // again until the renderer is recreated; the render calls become no-ops rather than throwing into
        // the decode worker on every frame.
        Boolean IsDeviceLost{ get; };

        // The HRESULT from GetDeviceRemovedReason, or 0 if the device is healthy.
        Int32 DeviceRemovedReason{ get; };

        // Raw IDXGISwapChain* as an integer, for the managed side to hand to ISwapChainPanelNative.
        UInt64 SwapChainPointer{ get; };

        // Test hook: clear the current back buffer to a color and present.
        void RenderClear(Single red, Single green, Single blue);

        // Test hook: upload a BGRA frame to a texture and draw it (scaled) to fill the surface, then
        // present. Not the live video path.
        void PresentBgra(UInt8[] bgra, UInt32 width, UInt32 height);

        // Decode one Annex-B access unit and present the latest frame.
        // Convenience = DecodeH264 + PresentLatestFrame.
        void SubmitH264(UInt8[] annexB);

        // Decode one Annex-B access unit (H.264 or HEVC, whatever the name says) WITHOUT presenting. The
        // most-recently decoded frame is retained for PresentLatestFrame. This lets the caller decode
        // every frame (keeping the reference chain intact) while presenting only the newest, so a
        // slow present never forces a frame drop that would corrupt the stream.
        // byteCount is how many leading bytes of the array are valid, so the caller can pass a pooled
        // buffer larger than the access unit (0 = the whole array). Feeding the unused tail to the
        // decoder would corrupt the bitstream.
        void DecodeH264(UInt8[] annexB, UInt32 byteCount);

        // Codec the decoder is built for. Must be set BEFORE the first decode call, because the MFT is created
        // lazily on first use and its input type is fixed at that point. Defaults to H264.
        void SetCodec(VideoCodecKind codec);

        // Which decoder MFT was actually selected, e.g. "Microsoft H264 Video Decoder MFT (DXVA)". Surfaced
        // because "HEVC requested" and "HEVC decoding" are different claims.
        String DecoderDescription{ get; };

        /// Raw decode-loop counters: samples produced, last ProcessOutput HRESULT, current output subtype, coded
        /// size, and how far geometry recovery got. For diagnosing "counters healthy but nothing on screen".
        String DecoderDiagnostic{ get; };

        // Present the most-recently decoded frame. No-op if nothing has decoded.
        void PresentLatestFrame();

        // Active decode path: 0 = software, 1 = hardware/DXVA with CPU readback, 2 = hardware/DXVA zero-copy.
        Int32 DecodeMode{ get; };

        // The resolution the decoder is actually producing, as negotiated from the incoming bitstream. This is
        // not necessarily what we asked for in the launchSpec — the console decides — so it is the only honest
        // answer to "what am I actually watching". 0 until the first frame has been decoded.
        UInt32 DecodedWidth{ get; };
        UInt32 DecodedHeight{ get; };

        /// The complete colour answer in one place: matrix, transfer function and primaries, each marked
        /// as signalled or assumed.
        String ColorMatrixDescription{ get; };

        /// Pixel format, e.g. "10-bit P010" or "8-bit NV12". Reported for SDR too, so the row cannot be
        /// confused with a format probe that never ran.
        String VideoFormatDescription{ get; };

        /// What the display is actually being given - "HDR10", "SDR", or which of the two reasons we are
        /// tone-mapping. Distinct from the stream's transfer function, which is a colour fact.
        String HdrOutputDescription{ get; };

        /// While Ripcord tone-maps HDR to SDR itself: the source peak its curve is using, and the latest frame's
        /// measured peak, in nits. Zero otherwise. Numbers, not prose, so the panel decides how to show them.
        Double ToneMapPeakNits{ get; };
        Double FramePeakNits{ get; };

        // The HDR state as three separate facts, because they are independent and the UI needs to tell them
        // apart. Do not infer them from ColorMatrixDescription: it says "PQ" whenever the *stream* is PQ, even
        // while we are tone-mapping to SDR on an SDR display.
        //
        // IsHdrTransfer   - the stream signals an HDR transfer function (PQ or HLG). Says nothing about output.
        // IsDisplayHdr    - the display accepts HDR10. Says nothing about the stream.
        // IsHdrOutput     - both of the above, and the swap chain accepted the colour space. This is the only
        //                   one that means "you are looking at HDR"; when it is false and IsHdrTransfer is
        //                   true, the picture is tone-mapped to SDR (HdrOutputDescription says by what).
        Boolean IsHdrTransfer{ get; };
        Boolean IsDisplayHdr{ get; };
        Boolean IsHdrOutput{ get; };

        // 10-bit decode (P010). Independent of HDR: a stream can be 10-bit and SDR.
        Boolean IsTenBit{ get; };

        // A 10-bit stream arrived with no zero-copy path to draw it, or the zero-copy path failed under it: the
        // readback path is 8-bit only, so nothing will show. The caller's cue to reconnect in SDR.
        Boolean CannotRenderTenBit{ get; };

        // Human-readable reason zero-copy fell back (failing stage + HRESULT), or "none".
        String ZeroCopyDiagnostic();

        // True once at least one frame has been decoded + retained (past the decoder's startup latency).
        Boolean HasDecodedFrame{ get; };

        // Resize the swap-chain buffers to match the panel's render size.
        void Resize(UInt32 width, UInt32 height);

        // Spatial upscale filter for the final present: 0 = bilinear, 1 = bicubic (sharper).
        void SetUpscaleMode(Int32 mode);

        // Counter the SwapChainPanel's DPI composition scale so a physical-pixel back buffer maps 1:1.
        void SetCompositionScale(Single scaleX, Single scaleY);

        void Shutdown();
    }
}
